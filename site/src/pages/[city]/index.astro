---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { cityIds, getSector, getEvents, getPlaces } from '../../lib/sectors.js';
import { isNotable } from '../../lib/format.js';
import { rankPlaces } from '../../lib/places.js';

export function getStaticPaths() {
  return cityIds.map((city) => ({
    params: { city },
    props: { sector: getSector(city), events: getEvents(city), places: getPlaces(city) },
  }));
}

const { sector, events, places } = Astro.props;
const base = import.meta.env.BASE_URL;
const cityBase = `${base}${sector.id}/`;
const title = `QueFaire — ${sector.name} · sorties, événements et activités`;

// Activités permanentes : classées par intérêt (distinction officielle, insolite
// confirmé, présentation, horaires…) mais PLUS DE PLAFOND. Le plafond de 300
// existait parce qu'on pré-rendait chaque tuile en HTML — 2232 tuiles faisaient
// 3,7 Mo. C'était donc une limite de POIDS DE PAGE qui écartait 1900 activités de
// la recherche, alors que ce qui doit trier, ce sont les préférences du visiteur.
//
// On embarque désormais les données MAIGRES de tout le catalogue et le navigateur
// ne fabrique que les tuiles de la page affichée (`lib/placecard.js`). Mesuré :
// 0,35 Mo compressés pour 2232 fiches, contre 0,07 Mo pour la page qui n'en
// montrait que 300. Cinq fois plus, 280 Ko en absolu — et le plafond disparaît.
const sortedPlaces = rankPlaces(places);
const placeCategories = sector.place_categories || {};
const qualityLabels = sector.quality_labels || {};
const unusualCount = sortedPlaces.filter((p) => p.unusual).length;
// « Valeur sûre » = porte au moins une distinction officielle (la simple notice
// Wikipédia ne compte pas). Le chip n'apparaît que s'il a de quoi filtrer.
const notableCount = sortedPlaces.filter((p) => isNotable(p.quality)).length;

// Fiche maigre : uniquement ce dont la tuile et les filtres ont besoin. Les
// champs absents sont OMIS (et non mis à null) — sur 2232 fiches, les clés vides
// pesaient plus que les valeurs utiles.
//
// Le texte de recherche n'est PAS embarqué : il recopierait nom, présentation,
// description et commune, soit 112 Ko compressés de pure duplication — le poste
// le plus lourd du blob, mesuré. Il est reconstruit une fois au chargement par
// `texteRecherche()`, qui le met en cache. On y perd la recherche sur les tags de
// provenance (`dt:Church`), qui n'est pas un vocabulaire de visiteur.
const CHAMPS = ['id', 'name', 'category', 'commune', 'lat', 'lon', 'tldr', 'description',
                'url', 'opening_hours', 'fee', 'quality', 'unusual', 'image_url',
                'audience', 'rating', 'rating_count', 'rating_source'];
const placesData = sortedPlaces.map((p) => {
  const maigre = {};
  for (const k of CHAMPS) {
    const v = p[k];
    if (v !== null && v !== undefined && v !== '' && !(Array.isArray(v) && !v.length)) maigre[k] = v;
  }
  return maigre;
});
// Communes du rayon avec leurs coordonnées : c'est ce qui permet de calculer un
// temps de trajet SANS géolocalisation, pour qui la refuse.
const communePoints = sector.commune_points || [];
---

<Base title={title} sector={sector}>
  {/* Deux colonnes : à GAUCHE tout ce qui se règle, à DROITE tout ce qui se
      parcourt. L'ancienne page empilait un héros centré, une rangée de chips et
      une barre d'outils de sept sélecteurs avant la première tuile : le visiteur
      devait traverser ses réglages pour atteindre les résultats, et les perdait
      de vue dès qu'il faisait défiler.

      La colonne de gauche est collante et défile indépendamment ; la barre de
      recherche l'est aussi, dans la colonne de droite, parce que c'est le seul
      réglage qu'on modifie EN LISANT les résultats. */}
  {/* `data-side` porte l'état de la colonne : ANCRÉE (elle occupe une colonne de
      la grille, donc l'exploration se redimensionne autour d'elle) ou FERMÉE
      (l'exploration récupère toute la largeur — quatre tuiles par rangée au lieu
      de trois). Sur petit écran la même colonne devient un rideau : il n'y a pas
      de largeur à partager. */}
  <div class="app-shell" id="shell" data-side="ancree">
    {/* Restaure l'état avant le premier rendu. Le script de module est différé :
        laissé à lui seul, une colonne mémorisée comme fermée s'affichait puis
        disparaissait, en refaisant la mise en page des 24 tuiles au passage. */}
    <script is:inline>
      try {
        if (window.matchMedia('(min-width: 1041px)').matches &&
            localStorage.getItem('quefaire:reglages') === 'fermee') {
          document.getElementById('shell').dataset.side = 'fermee';
        }
      } catch (e) { /* localStorage refusé : la colonne reste ancrée */ }
    </script>

    {/* Voile du rideau : seulement sous 1040 px, où la colonne recouvre la page
        au lieu de la partager. Échap et le voile la referment. */}
    <div class="side-veil" id="side-veil" hidden></div>

    <aside class="side" id="side" aria-label="Filtres et préférences">
      <div class="side-head">
        <h2>Réglages</h2>
        {/* La colonne offre sa propre fermeture, ancrée comme en rideau : sans
            elle, le seul moyen de récupérer la largeur était de retrouver le
            bouton du bandeau de recherche.

            Un chevron et non une croix : à 60 px sous celle du panneau de goûts,
            deux ✕ se lisent comme deux fermetures du même objet. Le chevron dit
            ce qui se passe vraiment — la colonne se range sur le côté. */}
        <button type="button" class="side-close" id="side-close" aria-label="Ranger la colonne de réglages" title="Ranger la colonne">«</button>
      </div>

      <div class="side-scroll">
        {/* Personnalisation par l'exemple. Un questionnaire d'accueil est un
            péage : quatre questions avant d'avoir rien vu. Deux avis sur des
            activités concrètes en apprennent davantage et se donnent en passant.

            EN TÊTE de la colonne, et pas en pied : c'est une invitation, pas un
            filtre. Placé en dernier, il tombait sous la ligne de flottaison de la
            colonne — un premier visiteur ne le voyait jamais, alors que c'est le
            seul endroit où la liste apprend à lui ressembler. Il disparaît de
            lui-même quand il n'a plus rien à proposer, et le pied de colonne le
            rouvre. */}
        <section class="fgroup tuner" id="tuner" hidden>
          <div class="tuner-head">
            <h3>👋 Ce qui vous plaît</h3>
            <button type="button" class="tuner-close" id="tuner-close" aria-label="Masquer">✕</button>
          </div>
          <p class="tuner-lead">
            <strong>Deux ou trois avis</strong> suffisent pour que la liste vous
            ressemble. Rien ne quitte ce navigateur.
          </p>
          <div class="tuner-cards" id="tuner-cards"></div>
          <p class="tuner-state" id="tuner-state"></p>
        </section>

        <section class="fgroup" role="group" aria-labelledby="fg-quand">
          <h3 id="fg-quand">Quand</h3>
          <div class="fchips">
            <button class="chip" data-chip="today" aria-pressed="false">☀️ Aujourd'hui</button>
            <button class="chip" data-chip="weekend" aria-pressed="false">📅 Ce week-end</button>
          </div>
        </section>

        <section class="fgroup" role="group" aria-labelledby="fg-qui">
          <h3 id="fg-qui">Pour qui, à quel prix</h3>
          <div class="fchips">
            <button class="chip" data-chip="famille" aria-pressed="false">👨‍👩‍👧 En famille</button>
            <button class="chip" data-chip="gratuit" aria-pressed="false">🆓 Gratuit</button>
          </div>
        </section>

        {places.length > 0 && (
          <section class="fgroup" role="group" aria-labelledby="fg-nature">
            <h3 id="fg-nature">Nature de la sortie</h3>
            <div class="fchips">
              {/* Pendant symétrique de « Activités permanentes » : l'actualité,
                  c'est-à-dire ce qui a une date et ne repassera pas. Sans lui, les
                  activités permanentes noyaient les événements et il n'y avait
                  aucun moyen de ne voir que ces derniers. */}
              <button class="chip" data-chip="evenements" aria-pressed="false">🎪 Événements datés</button>
              <button class="chip" data-chip="permanent" aria-pressed="false">🏛️ Toute l'année</button>
              {unusualCount > 0 && (
                <button class="chip" data-chip="insolite" aria-pressed="false">✨ Insolite</button>
              )}
              {notableCount > 0 && (
                <button class="chip" data-chip="valeur-sure" aria-pressed="false">🏅 Valeurs sûres</button>
              )}
            </div>
          </section>
        )}

        <section class="fgroup" role="group" aria-labelledby="fg-ou">
          <h3 id="fg-ou">Où, et à quelle distance</h3>
          <div class="fchips">
            <button class="chip" data-chip="nearme" aria-pressed="false">📍 Près de moi</button>
          </div>
          <label class="field">
            <span class="field-label">🏠 Point de départ</span>
            <input
              id="origin"
              list="communes-list"
              type="text"
              placeholder={`ex. ${sector.name}`}
              autocomplete="off"
              aria-label="Commune de départ pour le calcul des temps de trajet"
            />
          </label>
          <datalist id="communes-list">
            {communePoints.map((c) => <option value={c.nom}>{c.nom}</option>)}
          </datalist>
          <div class="field-row">
            <label class="field">
              <span class="field-label">⏱ Trajet max.</span>
              <select id="timelimit">
                <option value="">sans limite</option>
                <option value="10">10 min</option>
                <option value="15">15 min</option>
                <option value="30">30 min</option>
                <option value="45">45 min</option>
                <option value="60">1 h</option>
              </select>
            </label>
            <label class="field">
              <span class="field-label">🚗 Moyen</span>
              <select id="timemode">
                <option value="car">voiture</option>
                <option value="bike">vélo</option>
                <option value="walk">à pied</option>
              </select>
            </label>
          </div>
          <p class="field-note" id="geostate"></p>
        </section>

        <section class="fgroup" role="group" aria-labelledby="fg-vue">
          <h3 id="fg-vue">Affichage</h3>
          <div class="field-row">
            <label class="field">
              <span class="field-label">↕ Trier par</span>
              <select id="sortby">
                {/* « Pour vous » n'apparaît qu'une fois qu'il y a de quoi le
                    nourrir : une option qui ne changerait rien serait une promesse
                    creuse. Le script l'ajoute et la sélectionne au premier vote. */}
                <option value="pertinence">pertinence</option>
                <option value="distance">distance</option>
                <option value="date">date</option>
                {/* « Gratuit d'abord » et non « prix croissant » : on ne dispose
                    que d'un booléen de gratuité et d'un texte de tarif libre, pas
                    d'un montant comparable. Annoncer un tri par prix serait
                    mentir. */}
                <option value="gratuit">gratuit d'abord</option>
                <option value="nom">nom</option>
              </select>
            </label>
            <label class="field">
              <span class="field-label">▦ Par page</span>
              <select id="pagesize">
                <option value="12">12</option>
                <option value="24" selected>24</option>
                <option value="48">48</option>
                <option value="0">tout</option>
              </select>
            </label>
          </div>
        </section>


      </div>

      {/* HORS de la zone défilante : ces deux actions doivent rester sous la main
          quel que soit l'état du panneau de goûts. Dans le flux, elles passaient
          sous la ligne de flottaison de la colonne dès que le panneau s'ouvrait. */}
      <div class="side-actions">
        <button class="side-link" id="tuner-open" type="button">👍 Personnaliser la liste</button>
        <button class="side-reset" id="reset" type="button">Tout réafficher</button>
      </div>
    </aside>

    <main class="explore">
      <header class="explore-intro">
        <h1>QueFaire —&nbsp;<em>{sector.name}</em></h1>
        <p class="sub">
          Concerts, randos, marchés, spectacles… {sector.event_count} idées de sorties
          collectées automatiquement auprès des communes et offices de tourisme
          {places.length > 0 && (
            <> — plus <strong>{sortedPlaces.length} activités ouvertes toute l'année</strong>
            {unusualCount > 0 && <>, dont {unusualCount} insolites</>}</>
          )}.
        </p>
      </header>

      {/* Collant : ce bandeau ne porte que ce qu'on modifie EN LISANT les
          résultats — la recherche, l'accès aux réglages, et le passage en carte.
          Les trois restent sous la main pendant le défilement.

          La carte était une chip perdue au fond de la colonne « Affichage » :
          pour y basculer il fallait remonter, ouvrir la colonne, la faire défiler.
          À sa place ici, c'est ce qu'elle est vraiment — un mode de vue, pas un
          filtre — et elle s'active depuis n'importe quel point de la liste. */}
      <div class="explore-top">
        <button type="button" class="side-toggle" id="side-open" aria-expanded="true" aria-controls="side">
          <span aria-hidden="true">☰</span>
          <span class="st-label">Réglages</span><span class="filter-badge" id="filter-badge" hidden></span>
        </button>
        <form class="searchbar" id="searchform" role="search">
          <input
            id="searchinput"
            type="search"
            placeholder="Ex : une sortie en famille ce week-end…"
            aria-label="Rechercher une activité"
            autocomplete="off"
          />
          {/* Libellé sur grand écran, loupe sur téléphone : à 390 px, « Chercher »
              et « Affiner » ne laissaient que 90 px au champ de saisie. Le nom
              accessible reste le mot, pas l'émoji. */}
          <button type="submit" aria-label="Chercher">
            <span class="sb-label">Chercher</span>
            <span class="sb-icon" aria-hidden="true">🔍</span>
          </button>
        </form>
        {/* `aria-pressed` et non `aria-expanded` : c'est une vue qu'on active, pas
            un panneau qu'on déplie. Le libellé tombe sous 640 px, l'émoji reste. */}
        <button type="button" class="chip map-toggle" id="mapchip" aria-pressed="false">
          <span aria-hidden="true">🗺️</span> <span class="mt-label">Carte</span>
        </button>
      </div>

      <p class="hints">
        Essayez :
        <button type="button" data-example>concert gratuit ce week-end</button> ·
        <button type="button" data-example>balade en famille à moins de 15 min</button> ·
        <button type="button" data-example>marché près de moi</button>
      </p>

      {/* Ce qui contraint la liste doit rester LISIBLE depuis les résultats : la
          colonne de gauche peut être défilée ou fermée, et un filtre qu'on a
          oublié d'avoir posé se lit comme un catalogue vide. Chaque pastille se
          retire d'un clic. */}
      <div class="resultbar">
        {/* Valeur de repli pour un rendu sans JavaScript ; `apply()` la recalcule
            dès le chargement et à chaque filtre. */}
        <span class="count" id="count">
          {events.length} événements · {sortedPlaces.length} activités permanentes
        </span>
        <div class="activefilters" id="activefilters"></div>
      </div>

      <div id="mapwrap" hidden>
        {/* Le cadre porte le positionnement : `#map` crée son propre contexte
            d'empilement (z-index: 1), donc un bouton posé DEDANS passerait sous
            les couches de Leaflet. */}
        <div class="map-frame">
          <div id="map"></div>
          {/* Un bouton HTML plutôt qu'un contrôle Leaflet : il doit se styler
              avec le reste de la page et rester dans l'ordre de tabulation du
              document. */}
          <button type="button" class="map-locate" id="map-locate" aria-pressed="false">
            <span class="ml-icon" aria-hidden="true">📍</span>
            <span class="ml-label">Ma position</span>
          </button>
        </div>
        <p class="map-note">Temps de trajet estimés à vol d'oiseau corrigé — un calcul d'itinéraire précis arrive en roadmap.</p>
        {/* Le même message qu'en colonne de réglages, répété ici : la colonne
            peut être fermée, et un échec de localisation doit se lire à l'endroit
            où on vient de cliquer. */}
        <p class="map-geo" id="map-geo" role="status"></p>
      </div>

      {/* Deux sections plutôt qu'une grille mêlée : un concert du 12 avril et un
          musée ouvert toute l'année ne se comparent pas, et les trier ensemble
          obligeait à un ordre arbitraire (« les datés d'abord »). Séparés, chacun
          garde son ordre naturel. Les filtres, eux, s'appliquent aux deux. */}
      <section class="section" id="sec-events">
        <div class="section-head">
          <h2>🎪 À l'affiche</h2>
          <span class="section-count" id="count-events"></span>
        </div>
        <p class="section-hint">Événements datés — ils ne repasseront pas.</p>
        <div class="grid" id="grid-events">
          {events.map((event) => <EventCard event={event} cityBase={cityBase} categories={sector.categories} />)}
        </div>
        <nav class="pager" id="pager-events" aria-label="Pages des événements"></nav>
      </section>

      <section class="section" id="sec-places">
        <div class="section-head">
          <h2>🏛️ Toute l'année</h2>
          <span class="section-count" id="count-places"></span>
        </div>
        <p class="section-hint">Activités permanentes — à faire quand vous voulez.</p>
        {/* Grille vide au départ : les tuiles sont fabriquées par le navigateur,
            page par page, depuis `places-data`. C'est ce qui supprime le plafond. */}
        <div class="grid" id="grid-places"></div>
        <noscript>
          <p class="section-hint">
            Les {sortedPlaces.length} activités permanentes de ce secteur nécessitent
            JavaScript pour être parcourues et filtrées. Les événements datés
            ci-dessus s'affichent sans.
          </p>
        </noscript>
        <nav class="pager" id="pager-places" aria-label="Pages des activités"></nav>
      </section>

      <div class="empty" id="empty">
        <div class="big">🔍</div>
        <p>
          Rien ne correspond à cette recherche pour l'instant.<br />
          Élargissez les dates ou <button type="button" class="chip" id="empty-reset">réaffichez tout</button>.
        </p>
      </div>
    </main>
  </div>

  <script id="sector-data" type="application/json" is:inline set:html={JSON.stringify(sector)}></script>
  {/* Catalogue complet en données maigres. Inline plutôt qu'en fichier séparé :
      la recherche a besoin de tout avant de pouvoir répondre, donc un second
      aller-retour réseau ne gagnerait rien, et le blob se compresse avec la page. */}
  <script id="places-data" type="application/json" is:inline set:html={JSON.stringify(placesData)}></script>
</Base>

<script>
  import { parseQuery, matches, distanceKm, travelMinutes, roundMinutes, fold } from '../../lib/nlsearch.js';
  import { creerCarte } from '../../lib/carte.js';
  import { chercherCommune, geolocaliser, memoriser, oublier as oublierOrigine, restaurer } from '../../lib/origine.js';
  import { CATEGORY_EMOJI, PLACE_EMOJI, formatWhen, openingLabel } from '../../lib/format.js';
  import { carteActivite, donneesActivite } from '../../lib/placecard.js';
  import { aProposer, charger, nbVotes, oublier, resume, scorePrefs, voter } from '../../lib/prefs.js';

  // Le secteur de la page (multi-villes) est injecté en JSON dans le DOM plutôt
  // qu'importé statiquement — le script est partagé par toutes les routes [city].
  const sector = JSON.parse(document.getElementById('sector-data').textContent);

  const mapChip = document.getElementById('mapchip');
  const mapWrap = document.getElementById('mapwrap');

  // Les hauteurs de ce qui COLLE sont MESURÉES, pas supposées. Elles décalent
  // tous les `position: sticky` de la page, et elles changent avec la largeur —
  // sur téléphone le menu passe à la ligne et l'en-tête triple de hauteur. La
  // valeur de 57 px codée en CSS cachait alors la barre de recherche DERRIÈRE
  // l'en-tête : le réglage censé rester sous la main était le seul invisible.
  //
  // `--sticky-h` est la somme : c'est ce que recouvre le haut de l'écran, donc
  // la marge de défilement dont une tuile ou un titre de section a besoin pour
  // ne pas arriver CACHÉ sous la carte.
  const entete = document.querySelector('.site-header');
  const barreHaute = document.querySelector('.explore-top');
  const racineCss = document.documentElement;

  function majHauteursCollantes() {
    const h = entete ? Math.round(entete.getBoundingClientRect().height) : 0;
    const t = barreHaute ? Math.round(barreHaute.getBoundingClientRect().height) : 0;
    const c = mapWrap.hidden ? 0 : Math.round(mapWrap.getBoundingClientRect().height);
    racineCss.style.setProperty('--header-h', `${h}px`);
    racineCss.style.setProperty('--top-h', `${t}px`);
    racineCss.style.setProperty('--sticky-h', `${h + t + c}px`);
  }

  const observateurCollant = new ResizeObserver(majHauteursCollantes);
  for (const el of [entete, barreHaute, mapWrap]) {
    if (el) observateurCollant.observe(el);
  }
  majHauteursCollantes();

  // Deux sections, deux grilles, deux paginations indépendantes : filtrer les
  // événements ne doit pas renvoyer les activités à leur première page.
  const SECTIONS = {
    event: {
      section: document.getElementById('sec-events'),
      grid: document.getElementById('grid-events'),
      pager: document.getElementById('pager-events'),
      count: document.getElementById('count-events'),
      page: 1,
      visible: [],
      un: 'événement', plusieurs: 'événements',
    },
    place: {
      section: document.getElementById('sec-places'),
      grid: document.getElementById('grid-places'),
      pager: document.getElementById('pager-places'),
      count: document.getElementById('count-places'),
      page: 1,
      visible: [],
      un: 'activité', plusieurs: 'activités',
    },
  };
  // Les ÉVÉNEMENTS sont pré-rendus (36 tuiles, elles marchent sans JavaScript et
  // portent le référencement). Les ACTIVITÉS sont des données : le navigateur
  // fabrique leurs tuiles page par page, ce qui supprime le plafond de 300.
  const eventCards = Array.from(SECTIONS.event.grid.querySelectorAll('.card'));
  const placesData = JSON.parse(document.getElementById('places-data').textContent);
  const ctxTuile = {
    categories: sector.place_categories || {},
    qualityLabels: sector.quality_labels || {},
    cityBase: new URL('.', location.href).pathname,
  };
  // Tuiles mises en cache une fois construites : revenir à une page déjà vue ne
  // doit pas tout refabriquer, et la fiche gardée par la carte reste la même.
  const tuiles = new Map();
  const tuileDe = (i) => {
    if (!tuiles.has(i)) tuiles.set(i, carteActivite(placesData[i], ctxTuile));
    return tuiles.get(i);
  };
  // Rang d'origine des événements, figé AVANT tout réordonnancement : une fois les
  // cartes déplacées par un tri, l'ordre du DOM ne dit plus celui du pipeline.
  const rangEvent = new Map(eventCards.map((card, i) => [card, i]));
  const sortEl = document.getElementById('sortby');
  const pageSizeEl = document.getElementById('pagesize');
  const input = document.getElementById('searchinput');
  const form = document.getElementById('searchform');
  const countEl = document.getElementById('count');
  const geostate = document.getElementById('geostate');
  const resetBtn = document.getElementById('reset');
  const emptyEl = document.getElementById('empty');
  const chips = Array.from(document.querySelectorAll('[data-chip]'));
  const timeLimitEl = document.getElementById('timelimit');
  const timeModeEl = document.getElementById('timemode');
  const locateBtn = document.getElementById('map-locate');
  const mapGeo = document.getElementById('map-geo');

  let origine = null;  // { lat, lon, source: 'geoloc'|'commune'|'defaut', libelle, precision }
  let prefs = charger();          // goûts appris par 👍/👎, dans ce navigateur seul
  const state = { query: '', chips: new Set() };
  const MODE_LABELS = { walk: 'à pied', bike: 'en vélo', car: 'en voiture' };
  const ESTIMATE_HINT =
    'Estimation depuis votre position jusqu’au centre de la commune (à vol d’oiseau corrigé)';

  const cardData = (card) => ({
    kind: card.dataset.kind || 'event',
    date: card.dataset.date,
    end: card.dataset.end,
    cat: card.dataset.cat,
    commune: card.dataset.commune,
    audience: card.dataset.audience,
    free: card.dataset.free,
    rating: card.dataset.rating,
    unusual: card.dataset.unusual,
    notable: card.dataset.notable,
    text: card.dataset.text,
    lat: parseFloat(card.dataset.lat),
    lon: parseFloat(card.dataset.lon),
  });

  function chipFilter(filter) {
    const now = new Date();
    const iso = (d) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    if (state.chips.has('today')) {
      filter.dateFrom = iso(now);
      filter.dateTo = iso(now);
    }
    if (state.chips.has('weekend')) {
      const sat = new Date(now);
      sat.setDate(sat.getDate() + ((6 - sat.getDay() + 7) % 7));
      const sun = new Date(sat);
      sun.setDate(sat.getDate() + 1);
      filter.dateFrom = iso(now.getDay() === 5 ? now : sat);
      filter.dateTo = iso(sun);
    }
    if (state.chips.has('famille') && !filter.audience.includes('famille')) {
      filter.audience.push('famille');
    }
    if (state.chips.has('gratuit')) filter.free = true;
    if (state.chips.has('nearme')) filter.nearMe = true;
    // Les trois chips « activités » restreignent au type permanent : demander
    // les insolites ou les mieux notées n'a pas de sens pour un événement daté.
    if (state.chips.has('evenements')) filter.kind = 'event';
    if (state.chips.has('permanent')) filter.kind = 'place';
    if (state.chips.has('insolite')) {
      filter.kind = 'place';
      filter.unusual = true;
    }
    if (state.chips.has('valeur-sure')) {
      filter.kind = 'place';
      filter.notable = true;
    }
    return filter;
  }

  // ---------------- Point de départ ----------------
  // Refuser la géolocalisation ne doit pas priver du filtre temps de trajet :
  // on retombait sur le centre du secteur, ce qui donne des temps faux pour qui
  // habite le bord du rayon. Le visiteur peut donc NOMMER sa commune. La table
  // de coordonnées est embarquée dans sector.json (géocodage hors-ligne, quelques
  // Ko) : aucun appel réseau, aucune donnée envoyée nulle part — et la précision
  // au centre de la commune est exactement celle de nos temps de trajet.
  //
  // Une origine DIT D'OÙ ELLE VIENT, et le marqueur en dépend : `defaut` (centre
  // du secteur) sert à calculer, jamais à afficher. Un point « Vous êtes ici »
  // posé sur une valeur de repli serait un mensonge.
  const originEl = document.getElementById('origin');
  const communePoints = sector.commune_points || [];

  function messageOrigine(texte) {
    geostate.textContent = texte;
    mapGeo.textContent = texte;
  }

  function appliquerOrigine(o, { message = '' } = {}) {
    origine = o;
    if (carte) carte.poserOrigine(o && o.source !== 'defaut' ? o : null);
    majBoutonPosition();
    messageOrigine(message);
  }

  function majBoutonPosition(occupe = false) {
    if (!locateBtn) return;
    const src = origine?.source;
    locateBtn.disabled = occupe;
    locateBtn.setAttribute('aria-busy', String(occupe));
    locateBtn.setAttribute('aria-pressed', String(src === 'geoloc'));
    locateBtn.classList.toggle('is-on', src === 'geoloc' || src === 'commune');
    locateBtn.querySelector('.ml-label').textContent = occupe ? 'Localisation…' : 'Ma position';
    locateBtn.title = occupe ? ''
      : src === 'geoloc' ? 'Recentrer la carte sur votre position'
        : src === 'commune' ? `Utiliser votre position réelle plutôt que ${origine.libelle}`
          : 'Afficher votre position sur la carte';
  }

  /** Applique la commune saisie comme point de départ. Rend true si reconnue. */
  function setOrigin(saisie) {
    const brut = (saisie || '').trim();
    if (!brut) {
      appliquerOrigine(null);
      oublierOrigine();
      return true;
    }
    const trouve = chercherCommune(communePoints, brut);
    if (!trouve) {
      messageOrigine(`« ${brut} » n'est pas dans le rayon — essayez une commune voisine.`);
      return false;
    }
    if (originEl) originEl.value = trouve.nom;
    memoriser(sector.id, trouve.nom);
    appliquerOrigine(
      { lat: trouve.lat, lon: trouve.lon, source: 'commune', libelle: trouve.nom, precision: null },
      { message: `Départ : ${trouve.nom}` },
    );
    return true;
  }

  const MESSAGES_GEO = {
    indisponible: 'Géolocalisation non disponible — indiquez votre commune ci-dessus.',
    imprecise: 'Position trop imprécise (localisation par le réseau) — indiquez votre commune ci-dessus.',
    refusee: 'Position refusée — indiquez votre commune ci-dessus.',
  };

  /** Garantit une origine pour les FILTRES qui en exigent une. À la différence du
   *  bouton 📍, cette voie se rabat sur le centre du secteur en cas d'échec :
   *  mieux vaut un temps de trajet approximatif et annoncé comme tel que pas de
   *  filtre du tout. Le marqueur, lui, n'est pas dessiné — `defaut` n'est pas
   *  une position. */
  async function assurerOrigine() {
    if (origine) return origine;
    try {
      const p = await geolocaliser();
      appliquerOrigine({ ...p, source: 'geoloc', libelle: 'Vous êtes ici' });
    } catch (err) {
      appliquerOrigine(
        { lat: sector.center.lat, lon: sector.center.lon, source: 'defaut', libelle: sector.name, precision: null },
        { message: `${MESSAGES_GEO[err.code] || MESSAGES_GEO.refusee} Calcul depuis ${sector.name} en attendant.` },
      );
      // Même geste que le bouton 📍 : sous 1040 px la colonne est un rideau
      // FERMÉ, et y poser le focus sans l'ouvrir l'enverrait hors écran — un
      // champ que personne ne voit n'aide personne à corriger le refus.
      ouvrirReglages(true, { rendreLeFocus: false });
      if (originEl) originEl.focus();
    }
    return origine;
  }

  function currentFilter() {
    const filter = chipFilter(parseQuery(state.query, sector.communes));
    // Les sélecteurs de la barre d'outils complètent la requête (elle prime).
    if (filter.maxMinutes == null && timeLimitEl.value) {
      filter.maxMinutes = parseInt(timeLimitEl.value, 10);
    }
    if (!filter.modeExplicit) filter.mode = timeModeEl.value;
    return filter;
  }

  function apply() {
    clearMapSelection(); // les fiches changent : la sélection carte n'a plus de sens
    const filter = currentFilter();
    // Trier par distance exige un point de départ, exactement comme « Près de
    // moi » : choisir ce tri déclenche donc la même demande (géolocalisation, ou
    // invitation à nommer sa commune si elle est refusée).
    const needsGeo = filter.nearMe || filter.maxMinutes != null || sortEl.value === 'distance';

    if (needsGeo && !origine) {
      assurerOrigine().then(apply);
      return;
    }

    // On MESURE dès qu'on sait d'où : cliquer 📍 doit suffire à faire apparaître
    // « ≈ 12 min en voiture » sur les tuiles, sans obliger à poser un filtre dont
    // on n'a que faire. `needsGeo` ne décide plus que de RÉCLAMER une position.
    const mesurer = origine != null;

    let shown = 0;
    let unlocated = 0;
    const visible = [];

    /** Juge une fiche, quelle que soit sa provenance, et l'ajoute si elle passe.
     *  `entree` porte de quoi la retrouver ensuite : une carte du DOM pour un
     *  événement, un index dans `placesData` pour une activité. */
    const juger = (data, entree) => {
      let ok = matches(data, filter);
      let dist = null;
      let minutes = null;
      if (ok && mesurer) {
        if (Number.isNaN(data.lat)) {
          // Sans coordonnées, impossible de garantir la limite de temps : on
          // exclut (la carte les ignore déjà — liste et carte restent cohérentes).
          if (filter.maxMinutes != null) {
            ok = false;
            unlocated += 1;
          }
        } else {
          dist = distanceKm(origine.lat, origine.lon, data.lat, data.lon);
          minutes = travelMinutes(dist, filter.mode);
          if (filter.maxMinutes != null && minutes > filter.maxMinutes) ok = false;
        }
      }
      if (!ok) return false;
      shown += 1;
      visible.push({
        ...entree, dist, minutes, data,
        date: data.date,
        isPlace: data.kind === 'place',
        notable: data.notable === 'true',
      });
      return true;
    };

    for (const card of eventCards) {
      const data = cardData(card);
      // Le rang d'origine dans le DOM est l'ordre voulu par le pipeline (la date).
      // C'est la « pertinence », et le repli des autres tris à égalité.
      const garde = juger(data, {
        card, rang: rangEvent.get(card),
        nom: card.querySelector('h3')?.textContent?.trim() || '',
        href: card.getAttribute('href'),
        opening: card.dataset.opening || '',
      });
      card.classList.toggle('hidden', !garde);
      if (!garde) card.querySelector('[data-role="distance"]').textContent = '';
    }

    // Les activités sont jugées sur leurs DONNÉES : aucune tuile n'est construite
    // pour une fiche écartée, ce qui rend le catalogue entier filtrable sans
    // payer 2232 rendus. `placesData` est déjà dans l'ordre de `rankPlaces`, donc
    // l'index vaut rang de pertinence.
    placesData.forEach((p, i) => {
      juger(donneesActivite(p, ctxTuile.categories), {
        index: i, rang: i, nom: p.name,
        href: p.url || `${ctxTuile.cityBase}activite/${p.id}/`,
        opening: p.opening_hours || '',
      });
    });

    // Chaque section garde son ordre naturel. `ordre` est le comparateur commun,
    // « pertinence » étant le seul à s'interpréter différemment selon le type :
    // une chronologie n'a pas de sens pour un lieu ouvert toute l'année, et un
    // score de documentation n'en a pas pour un concert daté.
    for (const [kind, sec] of Object.entries(SECTIONS)) {
      sec.visible = visible.filter((v) => (v.isPlace ? 'place' : 'event') === kind);
      sec.visible.sort(ordre(sortEl.value, kind));
      if (sec.page > pagesTotal(sec)) sec.page = 1; // le filtre a raccourci la liste
      rendre(sec);
    }

    const nbEvents = SECTIONS.event.visible.length;
    const nbPlaces = SECTIONS.place.visible.length;
    const parts = [];
    if (nbEvents || !nbPlaces) parts.push(nbEvents === 1 ? '1 événement' : `${nbEvents} événements`);
    if (nbPlaces) parts.push(nbPlaces === 1 ? '1 activité permanente' : `${nbPlaces} activités permanentes`);
    countEl.textContent =
      parts.join(' · ') +
      (unlocated > 0
        ? ` (+ ${unlocated} sans lieu précis, masqué${unlocated > 1 ? 's' : ''} par le filtre temps)`
        : '');
    emptyEl.classList.toggle('visible', shown === 0);
    majFiltresActifs();
    const isFiltered =
      state.query.trim() !== '' || state.chips.size > 0 || timeLimitEl.value !== '' ||
      sortEl.value !== 'pertinence';
    resetBtn.classList.toggle('visible', isFiltered);

    // La carte suit le FILTRE, pas la pagination : elle sert de vue d'ensemble
    // spatiale, la pagination n'est qu'un confort de lecture. Cliquer une bulle
    // dont la fiche est sur une autre page change de page — voir `allerA`.
    updateMap(visible, true);
  }

  /** Comparateur pour un type donné. */
  function ordre(critere, kind) {
    const parNom = (a, b) => fold(a.nom).localeCompare(fold(b.nom));
    const parDate = (a, b) => (a.date || '').localeCompare(b.date || '');
    // Pertinence : l'ordre du DOM, qui est déjà celui du pipeline — date pour les
    // événements, score de documentation pour les activités (`rankPlaces`).
    const parDefaut = (a, b) => a.rang - b.rang;
    switch (critere) {
      case 'distance':
        return (a, b) => (a.dist ?? Infinity) - (b.dist ?? Infinity) || parDefaut(a, b);
      case 'date':
        // Les activités permanentes n'ont pas de date : elles gardent leur ordre.
        return kind === 'event' ? parDate : parDefaut;
      case 'gratuit':
        return (a, b) =>
          Number(b.data.free === 'true') - Number(a.data.free === 'true') || parDefaut(a, b);
      case 'nom':
        return parNom;
      case 'gouts':
        // Les goûts REORDONNENT, ils ne masquent rien : une activité mal notée
        // recule, elle ne disparaît pas. Sur deux ou trois avis on ne sait
        // presque rien, et cacher sur cette base serait de la censure déguisée
        // en personnalisation.
        return (a, b) => scoreGout(b) - scoreGout(a) || parDefaut(a, b);
      default:
        return parDefaut;
    }
  }

  /** Score de goût d'une entrée. Les événements n'ont pas de fiche d'activité :
   *  on les note sur les traits qu'ils partagent (catégorie, gratuité). */
  function scoreGout(v) {
    const p = v.index != null ? placesData[v.index]
      : { id: '', category: v.data.cat, fee: v.data.free === 'true' ? false : null,
          unusual: v.data.unusual === 'true', quality: v.data.notable === 'true' ? ['x'] : [] };
    return scorePrefs(prefs, p);
  }

  const taillePage = () => parseInt(pageSizeEl.value, 10) || Infinity;
  const pagesTotal = (sec) => Math.max(1, Math.ceil(sec.visible.length / taillePage()));

  /** Élément d'une entrée : la carte pré-rendue d'un événement, ou la tuile
   *  d'activité fabriquée à la demande. */
  function elementDe(v) {
    const card = v.card ?? tuileDe(v.index);
    // Le chemin RETOUR, tuile → entrée : c'est ce qui permet au survol d'une
    // tuile de désigner son point sur la carte. Passage obligé des deux sortes
    // de tuiles, donc le seul endroit où l'inscrire.
    entreeDe.set(card, v);
    // Le temps de trajet s'écrit ici : pour une activité, la tuile peut n'exister
    // qu'au moment de son affichage, donc après le calcul de la distance.
    const distEl = card.querySelector('[data-role="distance"]');
    if (distEl) {
      distEl.textContent =
        v.minutes != null ? `≈ ${roundMinutes(v.minutes)} min ${MODE_LABELS[currentFilter().mode]}`
          : v.dist != null ? `≈ ${Math.round(v.dist)} km`
            : '';
      distEl.title = distEl.textContent ? ESTIMATE_HINT : '';
    }
    return card;
  }

  /** Réordonne la grille, n'affiche que la page courante, redessine le pageur.
   *
   *  Pour les activités, « n'afficher que la page » veut dire N'EN CONSTRUIRE que
   *  la page : la grille est vidée et regarnie, au lieu de masquer 2200 tuiles
   *  existantes. C'est tout l'intérêt du rendu client.
   */
  function rendre(sec) {
    const taille = taillePage();
    const debut = (sec.page - 1) * taille;
    const page = sec.visible.slice(debut, debut + taille);
    if (sec.grid === SECTIONS.place.grid) {
      sec.grid.replaceChildren(...page.map(elementDe));
    } else {
      sec.visible.forEach((v, i) => {
        const card = elementDe(v);
        sec.grid.appendChild(card);                        // l'ordre du tri
        card.classList.toggle('hidden', i < debut || i >= debut + taille);
      });
    }
    const n = sec.visible.length;
    sec.count.textContent = n ? `${n} ${n === 1 ? sec.un : sec.plusieurs}` : '';
    // Une section vide disparaît entièrement, titre compris : mieux qu'un
    // intertitre suivi du vide, et c'est ce que fait le filtre « Événements
    // datés » ou « Activités permanentes ».
    sec.section.hidden = n === 0;
    dessinerPageur(sec);
  }

  function dessinerPageur(sec) {
    const total = pagesTotal(sec);
    sec.pager.replaceChildren();
    if (total <= 1) return;
    const bouton = (libelle, page, courante = false, aria = null) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = libelle;
      b.className = 'page-btn' + (courante ? ' current' : '');
      if (aria) b.setAttribute('aria-label', aria);
      if (courante) b.setAttribute('aria-current', 'page');
      b.disabled = page == null;
      if (page != null) b.addEventListener('click', () => allerA(sec, page));
      sec.pager.appendChild(b);
      return b;
    };
    bouton('‹', sec.page > 1 ? sec.page - 1 : null, false, 'Page précédente');
    // Fenêtre glissante autour de la page courante : avec 300 activités et 12 par
    // page, aligner 25 numéros serait illisible.
    const debut = Math.max(1, Math.min(sec.page - 2, total - 4));
    const fin = Math.min(total, debut + 4);
    if (debut > 1) bouton('1', 1);
    if (debut > 2) bouton('…', null);
    for (let p = debut; p <= fin; p++) bouton(String(p), p, p === sec.page, `Page ${p}`);
    if (fin < total - 1) bouton('…', null);
    if (fin < total) bouton(String(total), total);
    bouton('›', sec.page < total ? sec.page + 1 : null, false, 'Page suivante');
  }

  function allerA(sec, page) {
    sec.page = Math.min(Math.max(1, page), pagesTotal(sec));
    rendre(sec);
    sec.section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ---------------- Carte (Leaflet, chargé à la demande) ----------------
  // Le pilotage de Leaflet vit dans `lib/carte.js` ; la page ne garde que ce qui
  // demande de connaître le catalogue — le vocabulaire des infobulles et le lien
  // retour vers les tuiles.
  let carte = null;
  let selectedCards = [];

  /** Met en évidence les fiches liées à la bulle cliquée sur la carte — une
   *  seule pour un marqueur isolé, toutes celles d'un groupe qui ne peut pas
   *  s'éclater (fiches au même point). */
  function selectCards(entrees) {
    for (const c of selectedCards) c.classList.remove('map-selected');
    selectedCards = [];
    if (!entrees.length) return;
    // La carte montre tout ce que les filtres retiennent, la liste n'en montre
    // qu'une page : la fiche visée peut donc être ailleurs — et s'il s'agit d'une
    // activité, sa tuile peut ne pas exister encore. On change de page D'ABORD,
    // puis on récupère les éléments, sinon on soulignerait des tuiles absentes.
    amenerSurSaPage(entrees[0]);
    selectedCards = entrees.map(elementDe);
    for (const c of selectedCards) c.classList.add('map-selected');
    selectedCards[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function amenerSurSaPage(entree) {
    for (const sec of Object.values(SECTIONS)) {
      const i = sec.visible.indexOf(entree);
      if (i < 0) continue;
      const page = Math.floor(i / taillePage()) + 1;
      if (page !== sec.page) {
        sec.page = page;
        rendre(sec);
      }
      return;
    }
  }

  function clearMapSelection() {
    for (const c of selectedCards) c.classList.remove('map-selected');
    selectedCards = [];
  }

  /** Contenu de l'infobulle affichée au survol d'un point : titre, catégorie,
   *  date et commune — comme un aperçu de la tuile. */
  function markerTooltip(it) {
    if (it.isPlace) {
      const cat = (sector.place_categories || {})[it.cat] || 'Activité';
      const lines = [
        `<span class="tt-title">${it.title}</span>`,
        `<span class="tt-line">${it.emoji} ${cat} · <strong>toute l’année</strong></span>`,
      ];
      if (it.unusual) lines.push('<span class="tt-line">✨ Insolite</span>');
      // Pas de note d'avis sur la carte : choix produit, et cela évite au
      // passage la contrainte « pas de contenu Places sur une carte non-Google ».
      if (it.notable) lines.push('<span class="tt-line">🏅 Distinction officielle</span>');
      const opening = openingLabel(it.opening);
      if (opening) lines.push(`<span class="tt-line">🕒 ${opening}</span>`);
      if (it.commune) lines.push(`<span class="tt-line">📍 ${it.commune}</span>`);
      lines.push('<span class="tt-hint">Cliquer pour voir la fiche dans la liste</span>');
      return lines.join('');
    }
    const emoji = CATEGORY_EMOJI[it.cat] || '📌';
    const cat = sector.categories[it.cat] || '';
    const when = formatWhen(it.date, it.end);
    const lines = [
      `<span class="tt-title">${it.title}</span>`,
      `<span class="tt-line">${emoji} ${cat}${when ? ` · ${when}` : ''}</span>`,
    ];
    if (it.commune) lines.push(`<span class="tt-line">📍 ${it.commune}</span>`);
    lines.push('<span class="tt-hint">Cliquer pour voir la fiche dans la liste</span>');
    return lines.join('');
  }

  /** Traduit les entrées retenues par le filtre en points de carte. Les points
   *  se construisent depuis les DONNÉES de l'entrée, jamais depuis son élément :
   *  une activité peut n'avoir aucune tuile fabriquée (elle est sur une autre
   *  page), et la carte doit malgré tout la montrer — elle suit le filtre, pas
   *  la pagination. */
  function itemsDe(visible) {
    const racine = getComputedStyle(document.documentElement);
    const items = [];
    for (const v of visible) {
      const { data, isPlace, notable } = v;
      if (Number.isNaN(data.lat)) continue;
      const it = {
        entree: v,
        lat: data.lat, lon: data.lon, cat: data.cat, commune: data.commune,
        date: data.date, end: data.end,
        isPlace, notable,
        unusual: data.unusual === 'true',
        emoji: isPlace ? PLACE_EMOJI[data.cat] || '📍' : CATEGORY_EMOJI[data.cat] || '📌',
        opening: v.opening || '',
        title: (v.nom || '').replace(/\s*↗$/, ''),
        href: v.href,
        color: racine.getPropertyValue(`--${isPlace ? 'p' : 'c'}-${data.cat}`).trim() || 'currentColor',
      };
      it.tooltip = markerTooltip(it);
      items.push(it);
    }
    return items;
  }

  function updateMap(visible, recadrer) {
    if (!carte || mapWrap.hidden) return;
    carte.afficher(itemsDe(visible), { recadrer });
  }

  // ---------------- Survol d'une tuile → son point sur la carte ------------
  // Le lien carte → liste existait déjà (cliquer un point remonte à sa tuile).
  // C'est le chemin INVERSE qui manquait, et c'est le plus fréquent : on parcourt
  // la liste, et on veut savoir où se trouve ce qu'on lit.
  const entreeDe = new WeakMap();
  let survolTimer = null;

  function survolerDepuis(el) {
    clearTimeout(survolTimer);
    // Anti-rebond : sans lui, un passage de souris sur une rangée déclenche six
    // recadrages, et la carte part en tous sens.
    survolTimer = setTimeout(() => {
      if (!carte || mapWrap.hidden) return;
      carte.survoler(el ? entreeDe.get(el) || null : null);
    }, 80);
  }

  for (const sec of Object.values(SECTIONS)) {
    // `pointer*` plutôt que `mouse*` : le survol n'existe pas au doigt, et une
    // tape navigue déjà vers la fiche — mettre un point en évidence au passage
    // ferait bouger la carte sous un doigt qui essaie de faire défiler.
    sec.grid.addEventListener('pointerover', (e) => {
      if (e.pointerType === 'touch') return;
      survolerDepuis(e.target.closest('.card'));
    });
    sec.grid.addEventListener('pointerout', (e) => {
      if (e.pointerType === 'touch') return;
      if (!e.relatedTarget || !sec.grid.contains(e.relatedTarget)) survolerDepuis(null);
    });
    // Le clavier a droit au même repère que la souris : les tuiles sont des
    // liens, donc elles reçoivent le focus à la tabulation.
    sec.grid.addEventListener('focusin', (e) => survolerDepuis(e.target.closest('.card')));
    sec.grid.addEventListener('focusout', (e) => {
      if (!e.relatedTarget || !sec.grid.contains(e.relatedTarget)) survolerDepuis(null);
    });
  }

  mapChip.addEventListener('click', async () => {
    mapWrap.hidden = !mapWrap.hidden;
    mapChip.setAttribute('aria-pressed', String(!mapWrap.hidden));
    // Fermer la carte doit RENDRE au défilement les 300 px qu'elle réservait :
    // sans ce rappel, `--sticky-h` garderait la hauteur d'une carte absente et
    // toutes les cibles de défilement s'arrêteraient trop tôt.
    majHauteursCollantes();
    if (!mapWrap.hidden) {
      if (!carte) {
        carte = await creerCarte({
          el: document.getElementById('map'),
          centre: sector.center,
          onSelection: selectCards,
        });
      }
      carte.redimensionner();
      carte.poserOrigine(origine && origine.source !== 'defaut' ? origine : null);
      apply();
    }
  });

  // Un geste EXPLICITE, jamais une demande automatique à l'ouverture de la
  // carte : une boîte de dialogue du navigateur que personne n'a réclamée est le
  // contraire de la ligne du projet — rien ne se déclenche dans le dos du
  // visiteur, et rien ne quitte son navigateur.
  locateBtn.addEventListener('click', async () => {
    // `mapWrap` se découvre AVANT que `creerCarte()` (import dynamique de
    // Leaflet) ait fini de résoudre : le bouton est cliquable pendant cette
    // fenêtre, avec `carte` encore à `null`. Sans ce garde, un clic pendant le
    // chargement lève un TypeError qu'un `catch` mal ciblé attribuerait à tort
    // à un refus de géolocalisation (voir plus bas).
    if (origine?.source === 'geoloc') {
      if (carte) carte.centrerSurOrigine();
      return;
    }
    majBoutonPosition(true);
    let p;
    try {
      // Le `try` ne couvre QUE cet appel : `err.code` ne veut dire quelque
      // chose que pour une erreur de `geolocaliser()`. L'y engloutir avec
      // `apply()` ferait retomber toute exception (un `carte` encore `null`,
      // par exemple) sur `MESSAGES_GEO.refusee` — soit affirmer un refus qui
      // n'a pas eu lieu, exactement le mensonge que cette tâche corrige.
      p = await geolocaliser();
    } catch (err) {
      // Un échec ne fait JAMAIS perdre une commune déjà posée : `origine` reste
      // en place, seul le message change.
      majBoutonPosition(false);
      messageOrigine(`${MESSAGES_GEO[err.code] || MESSAGES_GEO.refusee} (☰ Réglages)`);
      ouvrirReglages(true, { rendreLeFocus: false });
      if (originEl) originEl.focus();
      return;
    }
    // La position précise remplace la commune : le champ se vide, sa pastille
    // disparaît, et la mémoire suit. La règle est que LA MÉMOIRE EST LE REFLET
    // DU CHAMP — une seule règle, donc rien à deviner.
    if (originEl) originEl.value = '';
    oublierOrigine();
    appliquerOrigine({ ...p, source: 'geoloc', libelle: 'Vous êtes ici' });
    // `apply()` D'ABORD, le recentrage ENSUITE : deux animations Leaflet
    // lancées dans le même tick ne s'additionnent pas, la DERNIÈRE écrase la
    // cible de la première (`_animateZoom` réécrit `_animateToCenter` /
    // `_animateToZoom` à chaque appel, y compris pendant qu'une première
    // anime déjà). Si `centrerSurOrigine()` parlait en premier, le `fitBounds`
    // régional d'`apply()` gagnerait la course et la carte resterait cadrée
    // sur le secteur — le point ne serait alors centré que par accident.
    apply();
    if (carte) carte.centrerSurOrigine();
  });

  timeLimitEl.addEventListener('change', apply);
  timeModeEl.addEventListener('change', apply);

  // Changer de tri ou de taille de page ramène les deux sections à leur première
  // page : rester en page 7 d'un classement qui vient d'être refait n'aurait pas
  // de sens, et on y perdrait de vue le haut du nouveau classement.
  for (const el of [sortEl, pageSizeEl]) {
    el.addEventListener('change', () => {
      for (const sec of Object.values(SECTIONS)) sec.page = 1;
      apply();
    });
  }

  if (originEl) {
    // `change` couvre la sélection dans la liste ET la validation au clavier.
    originEl.addEventListener('change', () => {
      if (setOrigin(originEl.value)) apply();
    });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    state.query = input.value;
    // La requête peut activer chips et sélecteurs implicitement (retour visuel).
    const parsed = parseQuery(state.query, sector.communes);
    syncChips(parsed);
    if (parsed.maxMinutes != null) {
      const opt = Array.from(timeLimitEl.options).find((o) => o.value === String(parsed.maxMinutes));
      timeLimitEl.value = opt ? opt.value : '';
    }
    if (parsed.modeExplicit) timeModeEl.value = parsed.mode;
    apply();
  });

  input.addEventListener('input', () => {
    if (input.value === '') {
      state.query = '';
      apply();
    }
  });

  function syncChips(parsed) {
    for (const chip of chips) {
      const key = chip.dataset.chip;
      const active =
        state.chips.has(key) ||
        (key === 'gratuit' && parsed.free === true) ||
        (key === 'famille' && parsed.audience.includes('famille')) ||
        (key === 'nearme' && parsed.nearMe) ||
        (key === 'permanent' && parsed.kind === 'place') ||
        (key === 'evenements' && parsed.kind === 'event') ||
        (key === 'insolite' && parsed.unusual) ||
        (key === 'valeur-sure' && parsed.notable);
      chip.setAttribute('aria-pressed', String(active));
    }
  }

  // « Événements datés » et les trois chips d'activités permanentes demandent
  // des types OPPOSÉS : les activer ensemble ne rendrait rien. Activer l'un
  // relâche donc les autres, plutôt que de laisser l'ordre du code décider en
  // silence lequel gagne.
  const EXCLUSIFS = [['evenements'], ['permanent', 'insolite', 'valeur-sure']];

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const key = chip.dataset.chip;
      if (state.chips.has(key)) state.chips.delete(key);
      else {
        state.chips.add(key);
        const camp = EXCLUSIFS.find((g) => g.includes(key));
        if (camp) {
          for (const autre of EXCLUSIFS.flat()) {
            if (!camp.includes(autre)) state.chips.delete(autre);
          }
        }
      }
      for (const c of chips) {
        c.setAttribute('aria-pressed', String(state.chips.has(c.dataset.chip)));
      }
      apply();
    });
  }

  function resetAll() {
    state.query = '';
    state.chips.clear();
    input.value = '';
    timeLimitEl.value = '';
    sortEl.value = 'pertinence';
    for (const sec of Object.values(SECTIONS)) sec.page = 1;
    if (originEl) originEl.value = '';
    // Le point de départ retombe à « inconnu », pas au centre du secteur : mieux
    // vaut ne pas afficher de temps que d'en afficher un depuis un point que le
    // visiteur n'a pas choisi.
    appliquerOrigine(null);
    oublierOrigine();
    for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
    apply();
  }
  resetBtn.addEventListener('click', resetAll);
  document.getElementById('empty-reset').addEventListener('click', resetAll);

  for (const btn of document.querySelectorAll('[data-example]')) {
    btn.addEventListener('click', () => {
      input.value = btn.textContent;
      form.requestSubmit();
    });
  }

  // ---------------- Colonne de réglages : ancrée, ou en rideau -------------
  // DEUX régimes pour un seul panneau, choisis par la largeur disponible :
  //
  //  · au-delà de 1040 px la colonne est ANCRÉE — elle tient une vraie colonne de
  //    la grille. La fermer redimensionne l'exploration au lieu de la découvrir :
  //    les tuiles repassent de trois à quatre par rangée. C'est le point : on
  //    range ses réglages pour gagner de la place, pas pour les cacher.
  //  · en dessous, il n'y a pas de largeur à partager, donc c'est un rideau qui
  //    recouvre, avec voile et Échap.
  //
  // L'état ancré/fermé se mémorise, celui du rideau non : un rideau se referme à
  // chaque usage, s'en souvenir n'apprendrait rien.
  const shell = document.getElementById('shell');
  const side = document.getElementById('side');
  const sideVeil = document.getElementById('side-veil');
  const sideOpen = document.getElementById('side-open');
  const sideClose = document.getElementById('side-close');
  const filterBadge = document.getElementById('filter-badge');
  const MEMOIRE_SIDE = 'quefaire:reglages';
  const enRideau = window.matchMedia('(max-width: 1040px)');

  function ouvrirReglages(ouvert, { rendreLeFocus = true } = {}) {
    shell.dataset.side = ouvert ? 'ancree' : 'fermee';
    side.classList.toggle('open', ouvert);
    // Le voile n'a de sens qu'en rideau : ancrée, la colonne ne recouvre rien et
    // le reste de la page doit rester cliquable.
    sideVeil.hidden = !(ouvert && enRideau.matches);
    sideOpen.setAttribute('aria-expanded', String(ouvert));
    if (!enRideau.matches) {
      try { localStorage.setItem(MEMOIRE_SIDE, ouvert ? 'ancree' : 'fermee'); } catch (e) { /* refusé */ }
    }
    // Le focus suit le panneau : à l'ouverture dedans, au retour sur le bouton —
    // sinon la navigation au clavier reste derrière le voile.
    if (rendreLeFocus) (ouvert ? sideClose : sideOpen).focus();
    // La carte affichée change de largeur avec la colonne ; Leaflet ne le voit
    // pas tout seul et laisse des tuiles grises sur la bande découverte.
    if (carte && !mapWrap.hidden) requestAnimationFrame(() => carte.redimensionner());
  }

  function memoireSide() {
    try { return localStorage.getItem(MEMOIRE_SIDE); } catch (e) { return null; }
  }

  // Le script en ligne du gabarit a déjà posé l'état pour éviter un saut de mise
  // en page ; on s'aligne dessus, et en rideau on part fermé.
  ouvrirReglages(!enRideau.matches && memoireSide() !== 'fermee', { rendreLeFocus: false });

  // Franchir le seuil change le régime, pas le choix du visiteur : on repart de
  // l'état mémorisé côté ancré, et fermé côté rideau. Sans ça, un rideau ouvert
  // puis élargi laissait un voile en travers d'une page redevenue à deux colonnes.
  enRideau.addEventListener('change', () => {
    ouvrirReglages(!enRideau.matches && memoireSide() !== 'fermee', { rendreLeFocus: false });
  });

  sideOpen.addEventListener('click', () => ouvrirReglages(shell.dataset.side === 'fermee'));
  sideClose.addEventListener('click', () => ouvrirReglages(false));
  sideVeil.addEventListener('click', () => ouvrirReglages(false));
  document.addEventListener('keydown', (e) => {
    // Échap ne referme que le rideau : ancrée, la colonne fait partie de la page
    // et une touche d'annulation n'a pas à la faire disparaître.
    if (e.key === 'Escape' && enRideau.matches && side.classList.contains('open')) ouvrirReglages(false);
  });

  // ---------------- Filtres actifs, lisibles depuis les résultats ----------
  // La colonne de gauche peut être défilée, ou fermée sur mobile : un filtre
  // qu'on a oublié d'avoir posé se lit alors comme un catalogue vide. Chaque
  // contrainte est donc rappelée près du compteur, et se retire d'un clic.
  const activeEl = document.getElementById('activefilters');
  const LIBELLE_TRI = {
    gouts: 'pour vous', distance: 'par distance', date: 'par date',
    gratuit: 'gratuit d\'abord', nom: 'par nom',
  };

  function majFiltresActifs() {
    const pastilles = [];
    if (state.query.trim()) pastilles.push([`« ${state.query.trim()} »`, () => { state.query = ''; input.value = ''; }]);
    for (const chip of chips) {
      if (!state.chips.has(chip.dataset.chip)) continue;
      pastilles.push([chip.textContent.trim(), () => {
        state.chips.delete(chip.dataset.chip);
        chip.setAttribute('aria-pressed', 'false');
      }]);
    }
    if (originEl && originEl.value.trim()) {
      pastilles.push([`🏠 ${originEl.value.trim()}`, () => {
        originEl.value = '';
        appliquerOrigine(null);
        oublierOrigine();
      }]);
    }
    if (timeLimitEl.value) {
      const t = timeLimitEl.options[timeLimitEl.selectedIndex].textContent.trim();
      pastilles.push([`⏱ ${t} ${MODE_LABELS[timeModeEl.value]}`, () => { timeLimitEl.value = ''; }]);
    }
    if (sortEl.value !== 'pertinence') {
      pastilles.push([`↕ ${LIBELLE_TRI[sortEl.value] || sortEl.value}`, () => { sortEl.value = 'pertinence'; }]);
    }

    activeEl.replaceChildren(...pastilles.map(([libelle, retirer]) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'afilter';
      b.innerHTML = '';
      b.append(document.createTextNode(libelle));
      const croix = document.createElement('span');
      croix.className = 'afilter-x';
      croix.setAttribute('aria-hidden', 'true');
      croix.textContent = '✕';
      b.appendChild(croix);
      b.setAttribute('aria-label', `Retirer le filtre : ${libelle}`);
      b.addEventListener('click', () => {
        retirer();
        for (const sec of Object.values(SECTIONS)) sec.page = 1;
        apply();
      });
      return b;
    }));
    // Compteur sur le bouton « Affiner » : sur mobile la colonne est fermée, et
    // rien ne dirait combien de réglages sont en vigueur.
    const n = pastilles.length;
    filterBadge.textContent = n ? String(n) : '';
    filterBadge.hidden = n === 0;
  }

  // ---------------- Personnalisation par 👍/👎 ----------------
  const tuner = document.getElementById('tuner');
  const tunerCards = document.getElementById('tuner-cards');
  const tunerState = document.getElementById('tuner-state');

  /** Ajoute (une fois) l'option « pour vous » et la sélectionne. */
  function activerTriGouts(selectionner) {
    if (!sortEl.querySelector('[value="gouts"]')) {
      const opt = document.createElement('option');
      opt.value = 'gouts';
      opt.textContent = 'pour vous';
      sortEl.prepend(opt);
    }
    if (selectionner) sortEl.value = 'gouts';
  }

  function ligneVote(p) {
    const bloc = document.createElement('div');
    bloc.className = 'tuner-card';
    const titre = document.createElement('p');
    titre.className = 'tuner-title';
    titre.textContent = p.name;
    const quoi = document.createElement('p');
    quoi.className = 'tuner-what';
    quoi.textContent = [ctxTuile.categories[p.category] || 'Activité', p.commune]
      .filter(Boolean).join(' · ');
    const phrase = document.createElement('p');
    phrase.className = 'tuner-desc';
    phrase.textContent = (p.tldr || p.description || '').slice(0, 130);

    const boutons = document.createElement('div');
    boutons.className = 'tuner-votes';
    for (const [sens, libelle, aria] of [[1, '👍', "J'aime"], [-1, '👎', 'Pas pour moi']]) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'vote-btn';
      b.textContent = libelle;
      b.setAttribute('aria-label', `${aria} : ${p.name}`);
      b.addEventListener('click', () => {
        prefs = voter(prefs, p, sens);
        // Effet IMMÉDIAT et visible : sans retour instantané, le visiteur ne peut
        // pas savoir que son avis a compté, et ne donnera pas le suivant.
        activerTriGouts(true);
        for (const sec of Object.values(SECTIONS)) sec.page = 1;
        majTuner();
        apply();
      });
      boutons.appendChild(b);
    }
    bloc.append(titre, quoi, phrase, boutons);
    return bloc;
  }

  function majTuner() {
    const n = nbVotes(prefs);
    // UNE proposition à la fois, et non trois. Trois cartes remplissaient la
    // colonne entière et repoussaient tous les filtres sous la ligne de
    // flottaison — l'invitation chassait les réglages. Une seule carte garde la
    // colonne navigable, et la boucle est plus serrée : chaque avis fait
    // apparaître le suivant, dans une catégorie encore non jugée.
    const propositions = aProposer(prefs, placesData, 1);
    tunerCards.replaceChildren(...propositions.map(ligneVote));

    const dit = resume(prefs, ctxTuile.categories);
    if (n === 0) {
      tunerState.textContent = '';
    } else {
      tunerState.replaceChildren();
      const phrase = document.createElement('span');
      // Ce que QueFaire a compris, écrit noir sur blanc : le visiteur doit pouvoir
      // le vérifier, et le contredire. Un score invisible ne se conteste pas.
      const combien = n === 1 ? 'votre premier avis' : `vos ${n} avis`;
      phrase.textContent = dit
        ? `D'après ${combien} : ${dit}. La liste est réordonnée.`
        : `${combien} enregistré${n > 1 ? 's' : ''}, sans préférence nette pour l'instant.`;
      const effacer = document.createElement('button');
      effacer.type = 'button';
      effacer.className = 'tuner-forget';
      effacer.textContent = 'Effacer mes goûts';
      effacer.addEventListener('click', () => {
        prefs = oublier();
        sortEl.value = 'pertinence';
        sortEl.querySelector('[value="gouts"]')?.remove();
        majTuner();
        apply();
      });
      tunerState.append(phrase, document.createTextNode(' '), effacer);
    }
    // Plus rien à proposer : le panneau n'a plus de raison d'occuper le haut de
    // page. Il reste accessible par le bouton de la barre d'outils.
    tuner.hidden = propositions.length === 0;
  }

  document.getElementById('tuner-close').addEventListener('click', () => {
    tuner.hidden = true;
  });
  document.getElementById('tuner-open').addEventListener('click', () => {
    tuner.hidden = false;
    majTuner();
    tuner.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  if (nbVotes(prefs)) activerTriGouts(true);
  majTuner();

  // Premier calcul au chargement. Sans lui, le compteur gardait la valeur rendue
  // par le serveur — « 36 événements » — alors que la grille affichait déjà les
  // 336 tuiles, événements ET activités permanentes : le chiffre annonçait un
  // dixième de ce qu'on avait sous les yeux jusqu'à la première interaction.
  apply();
</script>
