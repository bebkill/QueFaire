---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { cityIds, getSector, getEvents, getPlaces } from '../../lib/sectors.js';
import { isNotable } from '../../lib/format.js';
import { MAX_RENDERED, rankPlaces } from '../../lib/places.js';

export function getStaticPaths() {
  return cityIds.map((city) => ({
    params: { city },
    props: { sector: getSector(city), events: getEvents(city), places: getPlaces(city) },
  }));
}

const { sector, events, places } = Astro.props;
const base = import.meta.env.BASE_URL;
const cityBase = `${base}${sector.id}/`;
const title = `QueFaire — ${sector.name} · sorties, événements et activités`;

// Activités permanentes : classées par intérêt (distinction officielle,
// insolite confirmé, présentation, horaires…) et PLAFONNÉES à l'affichage.
// Un rayon d'une heure en ramène ~2600 : toutes les rendre donnait une page de
// 3,7 Mo. places.json reste complet, seul le rendu est borné — et le nombre
// d'activités non affichées est annoncé, jamais tu.
const sortedPlaces = rankPlaces(places);
const hiddenPlaces = places.length - sortedPlaces.length;
const placeCategories = sector.place_categories || {};
const qualityLabels = sector.quality_labels || {};
const unusualCount = sortedPlaces.filter((p) => p.unusual).length;
// « Valeur sûre » = porte au moins une distinction officielle (la simple notice
// Wikipédia ne compte pas). Le chip n'apparaît que s'il a de quoi filtrer.
const notableCount = sortedPlaces.filter((p) => isNotable(p.quality)).length;
// Communes du rayon avec leurs coordonnées : c'est ce qui permet de calculer un
// temps de trajet SANS géolocalisation, pour qui la refuse.
const communePoints = sector.commune_points || [];
---

<Base title={title} sector={sector}>
  <section class="hero">
    <div class="wrap">
      <h1>QueFaire —&nbsp;<em>{sector.name}</em></h1>
      <p class="sub">
        Concerts, randos, marchés, spectacles… {sector.event_count} idées de sorties
        collectées automatiquement auprès des communes et offices de tourisme
        {places.length > 0 && (
          <> — plus <strong>{sortedPlaces.length} activités ouvertes toute l'année</strong>
          {unusualCount > 0 && <>, dont {unusualCount} insolites</>}</>
        )}.
      </p>

      <form class="searchbar" id="searchform" role="search">
        <input
          id="searchinput"
          type="search"
          placeholder="Ex : une sortie en famille ce week-end…"
          aria-label="Rechercher une activité"
          autocomplete="off"
        />
        <button type="submit">Chercher</button>
      </form>

      <p class="hints">
        Essayez :
        <button type="button" data-example>concert gratuit ce week-end</button> ·
        <button type="button" data-example>balade en famille à moins de 15 min</button> ·
        <button type="button" data-example>marché près de moi</button>
      </p>

      <div class="chips" id="chips">
        <button class="chip" data-chip="weekend" aria-pressed="false">📅 Ce week-end</button>
        <button class="chip" data-chip="today" aria-pressed="false">☀️ Aujourd'hui</button>
        <button class="chip" data-chip="famille" aria-pressed="false">👨‍👩‍👧 En famille</button>
        <button class="chip" data-chip="gratuit" aria-pressed="false">🆓 Gratuit</button>
        <button class="chip" data-chip="nearme" aria-pressed="false">📍 Près de moi</button>
        {places.length > 0 && (
          <>
            {/* Pendant symétrique de « Activités permanentes » : l'actualité,
                c'est-à-dire ce qui a une date et ne repassera pas. Sans lui, les
                2206 activités permanentes noyaient les 36 événements et il n'y
                avait aucun moyen de ne voir que ces derniers. */}
            <button class="chip" data-chip="evenements" aria-pressed="false">🎪 Événements datés</button>
            <button class="chip" data-chip="permanent" aria-pressed="false">🏛️ Activités permanentes</button>
            {unusualCount > 0 && (
              <button class="chip" data-chip="insolite" aria-pressed="false">✨ Insolite</button>
            )}
            {notableCount > 0 && (
              <button class="chip" data-chip="valeur-sure" aria-pressed="false">🏅 Valeurs sûres</button>
            )}
          </>
        )}
        <button class="chip" id="mapchip" aria-pressed="false">🗺️ Carte</button>
      </div>
    </div>
  </section>

  <main class="wrap">
    <div class="toolbar">
      {/* Valeur de repli pour un rendu sans JavaScript ; `apply()` la recalcule
          dès le chargement et à chaque filtre. */}
      <span class="count" id="count">
        {events.length} événements · {sortedPlaces.length} activités permanentes
      </span>
      <label class="timefilter origin-field">
        🏠 depuis
        <input
          id="origin"
          list="communes-list"
          type="text"
          placeholder={`ex. ${sector.name}`}
          autocomplete="off"
          aria-label="Commune de départ pour le calcul des temps de trajet"
        />
      </label>
      <datalist id="communes-list">
        {communePoints.map((c) => <option value={c.nom}>{c.nom}</option>)}
      </datalist>
      <label class="timefilter">
        ⏱ à moins de
        <select id="timelimit">
          <option value="">— (sans limite)</option>
          <option value="10">10 min</option>
          <option value="15">15 min</option>
          <option value="30">30 min</option>
          <option value="45">45 min</option>
          <option value="60">1 h</option>
        </select>
        <select id="timemode">
          <option value="car">en voiture</option>
          <option value="bike">en vélo</option>
          <option value="walk">à pied</option>
        </select>
      </label>
      <label class="timefilter">
        ↕ trier par
        <select id="sortby">
          <option value="pertinence">pertinence</option>
          <option value="distance">distance</option>
          <option value="date">date</option>
          {/* « Gratuit d'abord » et non « prix croissant » : on ne dispose que
              d'un booléen de gratuité et d'un texte de tarif libre, pas d'un
              montant comparable. Annoncer un tri par prix serait mentir. */}
          <option value="gratuit">gratuit d'abord</option>
          <option value="nom">nom</option>
        </select>
      </label>
      <label class="timefilter">
        ▦ par page
        <select id="pagesize">
          <option value="12">12</option>
          <option value="24" selected>24</option>
          <option value="48">48</option>
          <option value="0">tout</option>
        </select>
      </label>
      <span class="geostate" id="geostate"></span>
      <button class="reset" id="reset" type="button">Tout réafficher</button>
    </div>

    <div id="mapwrap" hidden>
      <div id="map"></div>
      <p class="map-note">Temps de trajet estimés à vol d'oiseau corrigé — un calcul d'itinéraire précis arrive en roadmap.</p>
    </div>

    {/* Deux sections plutôt qu'une grille mêlée : un concert du 12 avril et un
        musée ouvert toute l'année ne se comparent pas, et les trier ensemble
        obligeait à un ordre arbitraire (« les datés d'abord »). Séparés, chacun
        garde son ordre naturel. Les filtres, eux, s'appliquent aux deux. */}
    <section class="section" id="sec-events">
      <div class="section-head">
        <h2>🎪 À l'affiche</h2>
        <span class="section-count" id="count-events"></span>
      </div>
      <p class="section-hint">Événements datés — ils ne repasseront pas.</p>
      <div class="grid" id="grid-events">
        {events.map((event) => <EventCard event={event} cityBase={cityBase} categories={sector.categories} />)}
      </div>
      <nav class="pager" id="pager-events" aria-label="Pages des événements"></nav>
    </section>

    <section class="section" id="sec-places">
      <div class="section-head">
        <h2>🏛️ Toute l'année</h2>
        <span class="section-count" id="count-places"></span>
      </div>
      <p class="section-hint">Activités permanentes — à faire quand vous voulez.</p>
      <div class="grid" id="grid-places">
        {sortedPlaces.map((place) => (
          <PlaceCard place={place} categories={placeCategories} sectorQuality={qualityLabels} cityBase={cityBase} />
        ))}
      </div>
      <nav class="pager" id="pager-places" aria-label="Pages des activités"></nav>
      {hiddenPlaces > 0 && (
        <p class="truncated-note">
          {hiddenPlaces} autres activités permanentes recensées dans le rayon ne sont pas
          affichées ici&nbsp;: la page montre les {MAX_RENDERED} plus documentées
          (distinction officielle, horaires, site officiel). La pagination découpe
          l'affichage, elle ne change pas ce que la page embarque.
        </p>
      )}
    </section>

    <div class="empty" id="empty">
      <div class="big">🔍</div>
      <p>
        Rien ne correspond à cette recherche pour l'instant.<br />
        Élargissez les dates ou <button type="button" class="chip" id="empty-reset">réaffichez tout</button>.
      </p>
    </div>
  </main>

  <script id="sector-data" type="application/json" is:inline set:html={JSON.stringify(sector)}></script>
</Base>

<script>
  import { parseQuery, matches, distanceKm, travelMinutes, roundMinutes, fold } from '../../lib/nlsearch.js';
  import { CATEGORY_EMOJI, PLACE_EMOJI, formatWhen, openingLabel } from '../../lib/format.js';

  // Le secteur de la page (multi-villes) est injecté en JSON dans le DOM plutôt
  // qu'importé statiquement — le script est partagé par toutes les routes [city].
  const sector = JSON.parse(document.getElementById('sector-data').textContent);

  // Deux sections, deux grilles, deux paginations indépendantes : filtrer les
  // événements ne doit pas renvoyer les activités à leur première page.
  const SECTIONS = {
    event: {
      section: document.getElementById('sec-events'),
      grid: document.getElementById('grid-events'),
      pager: document.getElementById('pager-events'),
      count: document.getElementById('count-events'),
      page: 1,
      visible: [],
      un: 'événement', plusieurs: 'événements',
    },
    place: {
      section: document.getElementById('sec-places'),
      grid: document.getElementById('grid-places'),
      pager: document.getElementById('pager-places'),
      count: document.getElementById('count-places'),
      page: 1,
      visible: [],
      un: 'activité', plusieurs: 'activités',
    },
  };
  const cards = Object.values(SECTIONS).flatMap((s) => Array.from(s.grid.querySelectorAll('.card')));
  // Rang d'origine figé AVANT tout réordonnancement : une fois les cartes
  // déplacées par un tri, l'ordre du DOM ne dit plus celui du pipeline.
  const rangInitial = new Map(cards.map((card, i) => [card, i]));
  const sortEl = document.getElementById('sortby');
  const pageSizeEl = document.getElementById('pagesize');
  const input = document.getElementById('searchinput');
  const form = document.getElementById('searchform');
  const countEl = document.getElementById('count');
  const geostate = document.getElementById('geostate');
  const resetBtn = document.getElementById('reset');
  const emptyEl = document.getElementById('empty');
  const chips = Array.from(document.querySelectorAll('[data-chip]'));
  const timeLimitEl = document.getElementById('timelimit');
  const timeModeEl = document.getElementById('timemode');
  const mapChip = document.getElementById('mapchip');
  const mapWrap = document.getElementById('mapwrap');

  let userPos = null; // {lat, lon}
  const state = { query: '', chips: new Set() };
  const MODE_LABELS = { walk: 'à pied', bike: 'en vélo', car: 'en voiture' };
  const ESTIMATE_HINT =
    'Estimation depuis votre position jusqu’au centre de la commune (à vol d’oiseau corrigé)';

  const cardData = (card) => ({
    kind: card.dataset.kind || 'event',
    date: card.dataset.date,
    end: card.dataset.end,
    cat: card.dataset.cat,
    commune: card.dataset.commune,
    audience: card.dataset.audience,
    free: card.dataset.free,
    rating: card.dataset.rating,
    unusual: card.dataset.unusual,
    notable: card.dataset.notable,
    text: card.dataset.text,
    lat: parseFloat(card.dataset.lat),
    lon: parseFloat(card.dataset.lon),
  });

  function chipFilter(filter) {
    const now = new Date();
    const iso = (d) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    if (state.chips.has('today')) {
      filter.dateFrom = iso(now);
      filter.dateTo = iso(now);
    }
    if (state.chips.has('weekend')) {
      const sat = new Date(now);
      sat.setDate(sat.getDate() + ((6 - sat.getDay() + 7) % 7));
      const sun = new Date(sat);
      sun.setDate(sat.getDate() + 1);
      filter.dateFrom = iso(now.getDay() === 5 ? now : sat);
      filter.dateTo = iso(sun);
    }
    if (state.chips.has('famille') && !filter.audience.includes('famille')) {
      filter.audience.push('famille');
    }
    if (state.chips.has('gratuit')) filter.free = true;
    if (state.chips.has('nearme')) filter.nearMe = true;
    // Les trois chips « activités » restreignent au type permanent : demander
    // les insolites ou les mieux notées n'a pas de sens pour un événement daté.
    if (state.chips.has('evenements')) filter.kind = 'event';
    if (state.chips.has('permanent')) filter.kind = 'place';
    if (state.chips.has('insolite')) {
      filter.kind = 'place';
      filter.unusual = true;
    }
    if (state.chips.has('valeur-sure')) {
      filter.kind = 'place';
      filter.notable = true;
    }
    return filter;
  }

  // ---------------- Point de départ ----------------
  // Refuser la géolocalisation ne doit pas priver du filtre temps de trajet :
  // on retombait sur le centre du secteur, ce qui donne des temps faux pour qui
  // habite le bord du rayon. Le visiteur peut donc NOMMER sa commune. La table
  // de coordonnées est embarquée dans sector.json (géocodage hors-ligne, quelques
  // Ko) : aucun appel réseau, aucune donnée envoyée nulle part — et la précision
  // au centre de la commune est exactement celle de nos temps de trajet.
  const originEl = document.getElementById('origin');
  const communePoints = sector.commune_points || [];
  const parCle = new Map(communePoints.map((c) => [fold(c.nom), c]));

  /** Applique la commune saisie comme point de départ. Rend true si reconnue. */
  function setOrigin(saisie) {
    const cle = fold((saisie || '').trim());
    if (!cle) {
      userPos = null;
      geostate.textContent = '';
      return true;
    }
    const trouve = parCle.get(cle) || communePoints.find((c) => fold(c.nom).startsWith(cle));
    if (!trouve) {
      geostate.textContent = `« ${saisie} » n'est pas dans le rayon — essayez une commune voisine.`;
      return false;
    }
    userPos = { lat: trouve.lat, lon: trouve.lon };
    geostate.textContent = `Départ : ${trouve.nom}`;
    if (originEl) originEl.value = trouve.nom;
    return true;
  }

  function requestGeoloc(cb) {
    if (userPos) return cb();
    if (!navigator.geolocation) {
      geostate.textContent = 'Géolocalisation non disponible — indiquez votre commune ci-dessus.';
      return cb();
    }
    geostate.textContent = 'Localisation en cours…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userPos = { lat: pos.coords.latitude, lon: pos.coords.longitude };
        geostate.textContent = '';
        cb();
      },
      () => {
        // Position refusée : on N'INVENTE PAS un point de départ. On le demande,
        // et on se rabat sur le centre du secteur en le disant.
        geostate.textContent = `Position refusée — indiquez votre commune pour des temps justes (calcul depuis ${sector.name} en attendant).`;
        userPos = { lat: sector.center.lat, lon: sector.center.lon };
        if (originEl) originEl.focus();
        cb();
      },
      // Haute précision : privilégie le wifi/GPS à la géoloc par IP (peu fiable
      // sur ordinateur — souvent le nœud régional du fournisseur d'accès).
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
    );
  }

  function currentFilter() {
    const filter = chipFilter(parseQuery(state.query, sector.communes));
    // Les sélecteurs de la barre d'outils complètent la requête (elle prime).
    if (filter.maxMinutes == null && timeLimitEl.value) {
      filter.maxMinutes = parseInt(timeLimitEl.value, 10);
    }
    if (!filter.modeExplicit) filter.mode = timeModeEl.value;
    return filter;
  }

  function apply() {
    clearMapSelection(); // les fiches changent : la sélection carte n'a plus de sens
    const filter = currentFilter();
    // Trier par distance exige un point de départ, exactement comme « Près de
    // moi » : choisir ce tri déclenche donc la même demande (géolocalisation, ou
    // invitation à nommer sa commune si elle est refusée).
    const needsGeo = filter.nearMe || filter.maxMinutes != null || sortEl.value === 'distance';

    if (needsGeo && !userPos) {
      requestGeoloc(apply);
      return;
    }

    let shown = 0;
    let unlocated = 0;
    const visible = [];
    for (const card of cards) {
      const data = cardData(card);
      let ok = matches(data, filter);
      let dist = null;
      let minutes = null;
      if (ok && needsGeo && userPos) {
        if (Number.isNaN(data.lat)) {
          // Sans coordonnées, impossible de garantir la limite de temps : on
          // exclut (la carte les ignore déjà — liste et carte restent cohérentes).
          if (filter.maxMinutes != null) {
            ok = false;
            unlocated += 1;
          }
        } else {
          dist = distanceKm(userPos.lat, userPos.lon, data.lat, data.lon);
          minutes = travelMinutes(dist, filter.mode);
          if (filter.maxMinutes != null && minutes > filter.maxMinutes) ok = false;
        }
      }
      card.classList.toggle('hidden', !ok);
      const distEl = card.querySelector('[data-role="distance"]');
      if (ok) {
        shown += 1;
        distEl.textContent =
          filter.maxMinutes != null && minutes != null
            ? `≈ ${roundMinutes(minutes)} min ${MODE_LABELS[filter.mode]}`
            : dist != null
              ? `≈ ${Math.round(dist)} km`
              : '';
        distEl.title = distEl.textContent ? ESTIMATE_HINT : '';
        visible.push({
          card, dist, date: data.date, data,
          isPlace: data.kind === 'place',
          notable: data.notable === 'true',
          // Rang d'origine dans le DOM = ordre voulu par le pipeline (date pour
          // les événements, score de documentation pour les activités). C'est la
          // « pertinence », et le repli de tous les autres tris à égalité.
          rang: rangInitial.get(card),
          nom: card.querySelector('h3')?.textContent?.trim() || '',
        });
      } else {
        distEl.textContent = '';
      }
    }

    // Chaque section garde son ordre naturel. `ordre` est le comparateur commun,
    // « pertinence » étant le seul à s'interpréter différemment selon le type :
    // une chronologie n'a pas de sens pour un lieu ouvert toute l'année, et un
    // score de documentation n'en a pas pour un concert daté.
    for (const [kind, sec] of Object.entries(SECTIONS)) {
      sec.visible = visible.filter((v) => (v.isPlace ? 'place' : 'event') === kind);
      sec.visible.sort(ordre(sortEl.value, kind));
      if (sec.page > pagesTotal(sec)) sec.page = 1; // le filtre a raccourci la liste
      rendre(sec);
    }

    const nbEvents = SECTIONS.event.visible.length;
    const nbPlaces = SECTIONS.place.visible.length;
    const parts = [];
    if (nbEvents || !nbPlaces) parts.push(nbEvents === 1 ? '1 événement' : `${nbEvents} événements`);
    if (nbPlaces) parts.push(nbPlaces === 1 ? '1 activité permanente' : `${nbPlaces} activités permanentes`);
    countEl.textContent =
      parts.join(' · ') +
      (unlocated > 0
        ? ` (+ ${unlocated} sans lieu précis, masqué${unlocated > 1 ? 's' : ''} par le filtre temps)`
        : '');
    emptyEl.classList.toggle('visible', shown === 0);
    const isFiltered =
      state.query.trim() !== '' || state.chips.size > 0 || timeLimitEl.value !== '' ||
      sortEl.value !== 'pertinence';
    resetBtn.classList.toggle('visible', isFiltered);

    // La carte suit le FILTRE, pas la pagination : elle sert de vue d'ensemble
    // spatiale, la pagination n'est qu'un confort de lecture. Cliquer une bulle
    // dont la fiche est sur une autre page change de page — voir `allerA`.
    lastVisible = visible;
    updateMap(visible, true);
  }

  /** Comparateur pour un type donné. */
  function ordre(critere, kind) {
    const parNom = (a, b) => fold(a.nom).localeCompare(fold(b.nom));
    const parDate = (a, b) => (a.date || '').localeCompare(b.date || '');
    // Pertinence : l'ordre du DOM, qui est déjà celui du pipeline — date pour les
    // événements, score de documentation pour les activités (`rankPlaces`).
    const parDefaut = (a, b) => a.rang - b.rang;
    switch (critere) {
      case 'distance':
        return (a, b) => (a.dist ?? Infinity) - (b.dist ?? Infinity) || parDefaut(a, b);
      case 'date':
        // Les activités permanentes n'ont pas de date : elles gardent leur ordre.
        return kind === 'event' ? parDate : parDefaut;
      case 'gratuit':
        return (a, b) =>
          Number(b.data.free === 'true') - Number(a.data.free === 'true') || parDefaut(a, b);
      case 'nom':
        return parNom;
      default:
        return parDefaut;
    }
  }

  const taillePage = () => parseInt(pageSizeEl.value, 10) || Infinity;
  const pagesTotal = (sec) => Math.max(1, Math.ceil(sec.visible.length / taillePage()));

  /** Réordonne la grille, n'affiche que la page courante, redessine le pageur. */
  function rendre(sec) {
    const taille = taillePage();
    const debut = (sec.page - 1) * taille;
    const fin = debut + taille;
    sec.visible.forEach(({ card }, i) => {
      sec.grid.appendChild(card);                       // l'ordre du tri
      card.classList.toggle('hidden', i < debut || i >= fin);  // la page courante
    });
    const n = sec.visible.length;
    sec.count.textContent = n ? `${n} ${n === 1 ? sec.un : sec.plusieurs}` : '';
    // Une section vide disparaît entièrement, titre compris : mieux qu'un
    // intertitre suivi du vide, et c'est ce que fait le filtre « Événements
    // datés » ou « Activités permanentes ».
    sec.section.hidden = n === 0;
    dessinerPageur(sec);
  }

  function dessinerPageur(sec) {
    const total = pagesTotal(sec);
    sec.pager.replaceChildren();
    if (total <= 1) return;
    const bouton = (libelle, page, courante = false, aria = null) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = libelle;
      b.className = 'page-btn' + (courante ? ' current' : '');
      if (aria) b.setAttribute('aria-label', aria);
      if (courante) b.setAttribute('aria-current', 'page');
      b.disabled = page == null;
      if (page != null) b.addEventListener('click', () => allerA(sec, page));
      sec.pager.appendChild(b);
      return b;
    };
    bouton('‹', sec.page > 1 ? sec.page - 1 : null, false, 'Page précédente');
    // Fenêtre glissante autour de la page courante : avec 300 activités et 12 par
    // page, aligner 25 numéros serait illisible.
    const debut = Math.max(1, Math.min(sec.page - 2, total - 4));
    const fin = Math.min(total, debut + 4);
    if (debut > 1) bouton('1', 1);
    if (debut > 2) bouton('…', null);
    for (let p = debut; p <= fin; p++) bouton(String(p), p, p === sec.page, `Page ${p}`);
    if (fin < total - 1) bouton('…', null);
    if (fin < total) bouton(String(total), total);
    bouton('›', sec.page < total ? sec.page + 1 : null, false, 'Page suivante');
  }

  function allerA(sec, page) {
    sec.page = Math.min(Math.max(1, page), pagesTotal(sec));
    rendre(sec);
    sec.section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ---------------- Carte (Leaflet, chargé à la demande) ----------------
  let leaflet = null; // { map, layer, L, userMarker }
  let lastVisible = [];
  let selectedCards = [];
  let popupCloseTimer = null;

  /** Met en évidence les fiches liées à la bulle cliquée sur la carte —
   *  une seule pour un marqueur isolé, toutes celles d'un cluster qui ne
   *  peut pas s'éclater (événements au même point). */
  function selectCards(cards) {
    clearTimeout(popupCloseTimer); // le popup précédent se ferme : ne pas désélectionner
    for (const c of selectedCards) c.classList.remove('map-selected');
    selectedCards = cards;
    for (const c of cards) c.classList.add('map-selected');
    if (!cards.length) return;
    // La carte montre tout ce que les filtres retiennent, la liste n'en montre
    // qu'une page : la fiche visée peut donc être ailleurs. On l'y amène, sinon
    // cliquer une bulle défilait vers une carte masquée — c'est-à-dire nulle part.
    amenerSurSaPage(cards[0]);
    cards[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function amenerSurSaPage(card) {
    for (const sec of Object.values(SECTIONS)) {
      const i = sec.visible.findIndex((v) => v.card === card);
      if (i < 0) continue;
      const page = Math.floor(i / taillePage()) + 1;
      if (page !== sec.page) {
        sec.page = page;
        rendre(sec);
      }
      return;
    }
  }

  function clearMapSelection() {
    for (const c of selectedCards) c.classList.remove('map-selected');
    selectedCards = [];
  }

  async function initMap() {
    const L = (await import('leaflet')).default;
    await import('leaflet/dist/leaflet.css');
    const map = L.map('map', { scrollWheelZoom: false }).setView(
      [sector.center.lat, sector.center.lon], 9
    );
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    leaflet = { L, map, layer: L.layerGroup().addTo(map), userMarker: null };
    // Le zoom change la granularité des clusters — sans recadrer la vue.
    map.on('zoomend', () => updateMap(lastVisible, false));
    // Popup fermé = plus rien de sélectionné. Le délai laisse le clic sur une
    // autre bulle (qui ferme ce popup pour ouvrir le sien) annuler l'effacement.
    map.on('popupclose', () => {
      clearTimeout(popupCloseTimer);
      popupCloseTimer = setTimeout(clearMapSelection, 80);
    });
  }

  /** Regroupe les points par proximité à l'écran (~70 px au zoom courant). */
  function buildClusters(items, map) {
    const RADIUS = 70;
    const zoom = map.getZoom();
    const clusters = [];
    for (const it of items) {
      const pt = map.project([it.lat, it.lon], zoom);
      let best = null;
      let bestD = Infinity;
      for (const cl of clusters) {
        const d = pt.distanceTo(cl.pt);
        if (d < RADIUS && d < bestD) { best = cl; bestD = d; }
      }
      if (best) {
        best.items.push(it);
        best.lat += (it.lat - best.lat) / best.items.length; // centroïde glissant
        best.lon += (it.lon - best.lon) / best.items.length;
        best.pt = map.project([best.lat, best.lon], zoom);
      } else {
        clusters.push({ lat: it.lat, lon: it.lon, pt, items: [it] });
      }
    }
    return clusters;
  }

  function zoomInto(cluster) {
    const { L, map } = leaflet;
    const bounds = L.latLngBounds(cluster.items.map((i) => [i.lat, i.lon]));
    const spread = bounds.getNorthEast().distanceTo(bounds.getSouthWest());
    if (spread < 100 || map.getZoom() >= 15) {
      // Tout au même endroit (géocodage à la commune) : liste plutôt que zoom,
      // et mise en évidence de toutes les fiches du cluster dans la grille.
      const links = cluster.items
        .slice(0, 12)
        .map((i) => `<a href="${i.href}">${i.title}</a>`)
        .join('<br>');
      const more = cluster.items.length > 12 ? `<br>… et ${cluster.items.length - 12} autres` : '';
      L.popup({ maxHeight: 220 }).setLatLng([cluster.lat, cluster.lon]).setContent(links + more).openOn(map);
      selectCards(cluster.items.map((i) => i.card));
    } else {
      map.fitBounds(bounds, { padding: [50, 50] });
    }
  }

  /** Cluster simple : pastille avec le nombre de fiches, clic → zoom. */
  function addCluster(cluster) {
    const { L, layer } = leaflet;
    const total = cluster.items.length;
    const size = Math.max(38, Math.min(64, 32 + total * 1.2));
    const onlyPlaces = cluster.items.every((i) => i.isPlace);
    const what = onlyPlaces ? 'activités' : 'fiches';
    const icon = L.divIcon({
      className: `cluster-icon${onlyPlaces ? ' cluster-places' : ''}`,
      html: `<div class="cluster-dot" style="width:${size}px;height:${size}px" title="${total} ${what} — cliquer pour zoomer">${total}</div>`,
      iconSize: [size, size],
      iconAnchor: [size / 2, size / 2],
    });
    L.marker([cluster.lat, cluster.lon], { icon })
      .on('click', () => zoomInto(cluster))
      .addTo(layer);
  }

  /** Contenu de l'infobulle affichée au survol d'un point : titre, catégorie,
   *  date et commune — comme un aperçu de la tuile. */
  function markerTooltip(it) {
    if (it.isPlace) {
      const cat = (sector.place_categories || {})[it.cat] || 'Activité';
      const lines = [
        `<span class="tt-title">${it.title}</span>`,
        `<span class="tt-line">${it.emoji} ${cat} · <strong>toute l’année</strong></span>`,
      ];
      if (it.unusual) lines.push('<span class="tt-line">✨ Insolite</span>');
      // Pas de note d'avis sur la carte : choix produit, et cela évite au
      // passage la contrainte « pas de contenu Places sur une carte non-Google ».
      if (it.notable) lines.push('<span class="tt-line">🏅 Distinction officielle</span>');
      const opening = openingLabel(it.opening);
      if (opening) lines.push(`<span class="tt-line">🕒 ${opening}</span>`);
      if (it.commune) lines.push(`<span class="tt-line">📍 ${it.commune}</span>`);
      lines.push('<span class="tt-hint">Cliquer pour voir la fiche dans la liste</span>');
      return lines.join('');
    }
    const emoji = CATEGORY_EMOJI[it.cat] || '📌';
    const cat = sector.categories[it.cat] || '';
    const when = formatWhen(it.date, it.end);
    const lines = [
      `<span class="tt-title">${it.title}</span>`,
      `<span class="tt-line">${emoji} ${cat}${when ? ` · ${when}` : ''}</span>`,
    ];
    if (it.commune) lines.push(`<span class="tt-line">📍 ${it.commune}</span>`);
    lines.push('<span class="tt-hint">Cliquer pour voir la fiche dans la liste</span>');
    return lines.join('');
  }

  function updateMap(visible, fitView) {
    if (!leaflet || mapWrap.hidden) return;
    const { L, map, layer } = leaflet;
    layer.clearLayers();

    const items = [];
    for (const { card, data, isPlace, notable } of visible) {
      if (Number.isNaN(data.lat)) continue;
      items.push({
        card,
        lat: data.lat, lon: data.lon, cat: data.cat, commune: data.commune,
        date: data.date, end: data.end,
        isPlace, notable,
        unusual: data.unusual === 'true',
        emoji: isPlace ? PLACE_EMOJI[data.cat] || '📍' : CATEGORY_EMOJI[data.cat] || '📌',
        opening: card.dataset.opening || '',
        title: card.querySelector('h3').textContent.replace(/\s*↗$/, ''),
        href: card.getAttribute('href'),
        color: getComputedStyle(card.querySelector('.card-top')).borderBottomColor,
      });
    }

    const points = [];
    for (const cluster of buildClusters(items, map)) {
      if (cluster.items.length >= 2) {
        addCluster(cluster);
        points.push([cluster.lat, cluster.lon]);
      } else {
        const it = cluster.items[0];
        // Activité permanente : pastille à icône, nettement distincte du point
        // coloré d'un événement — c'est le repère demandé « sur la carte ».
        const marker = it.isPlace
          ? L.marker([it.lat, it.lon], {
              icon: L.divIcon({
                className: 'place-icon',
                html: `<div class="place-dot${it.unusual ? ' is-unusual' : ''}">${it.emoji}</div>`,
                iconSize: [30, 30],
                iconAnchor: [15, 15],
              }),
            })
          : L.circleMarker([it.lat, it.lon], {
              radius: 8, color: it.color, fillColor: it.color, fillOpacity: 0.75, weight: 2,
            });
        marker
          // Survol : aperçu de la fiche. Clic : on remonte jusqu'à sa tuile
          // dans la liste (mise en évidence + défilement), sans popup.
          .bindTooltip(markerTooltip(it), {
            direction: 'top', offset: [0, -6], opacity: 1, className: 'event-tip',
          })
          .on('click', () => selectCards([it.card]))
          .addTo(layer);
        points.push([it.lat, it.lon]);
      }
    }

    if (userPos) {
      if (leaflet.userMarker) leaflet.userMarker.remove();
      leaflet.userMarker = L.circleMarker([userPos.lat, userPos.lon], {
        radius: 7, color: '#1c7ed6', fillColor: '#1c7ed6', fillOpacity: 1, weight: 3,
      }).bindPopup('Vous êtes ici').addTo(map);
      points.push([userPos.lat, userPos.lon]);
    }
    if (fitView && points.length) map.fitBounds(points, { padding: [40, 40], maxZoom: 13 });
  }

  mapChip.addEventListener('click', async () => {
    mapWrap.hidden = !mapWrap.hidden;
    mapChip.setAttribute('aria-pressed', String(!mapWrap.hidden));
    if (!mapWrap.hidden) {
      if (!leaflet) await initMap();
      leaflet.map.invalidateSize();
      apply();
    }
  });

  timeLimitEl.addEventListener('change', apply);
  timeModeEl.addEventListener('change', apply);

  // Changer de tri ou de taille de page ramène les deux sections à leur première
  // page : rester en page 7 d'un classement qui vient d'être refait n'aurait pas
  // de sens, et on y perdrait de vue le haut du nouveau classement.
  for (const el of [sortEl, pageSizeEl]) {
    el.addEventListener('change', () => {
      for (const sec of Object.values(SECTIONS)) sec.page = 1;
      apply();
    });
  }

  if (originEl) {
    // `change` couvre la sélection dans la liste ET la validation au clavier.
    originEl.addEventListener('change', () => {
      if (setOrigin(originEl.value)) apply();
    });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    state.query = input.value;
    // La requête peut activer chips et sélecteurs implicitement (retour visuel).
    const parsed = parseQuery(state.query, sector.communes);
    syncChips(parsed);
    if (parsed.maxMinutes != null) {
      const opt = Array.from(timeLimitEl.options).find((o) => o.value === String(parsed.maxMinutes));
      timeLimitEl.value = opt ? opt.value : '';
    }
    if (parsed.modeExplicit) timeModeEl.value = parsed.mode;
    apply();
  });

  input.addEventListener('input', () => {
    if (input.value === '') {
      state.query = '';
      apply();
    }
  });

  function syncChips(parsed) {
    for (const chip of chips) {
      const key = chip.dataset.chip;
      const active =
        state.chips.has(key) ||
        (key === 'gratuit' && parsed.free === true) ||
        (key === 'famille' && parsed.audience.includes('famille')) ||
        (key === 'nearme' && parsed.nearMe) ||
        (key === 'permanent' && parsed.kind === 'place') ||
        (key === 'evenements' && parsed.kind === 'event') ||
        (key === 'insolite' && parsed.unusual) ||
        (key === 'valeur-sure' && parsed.notable);
      chip.setAttribute('aria-pressed', String(active));
    }
  }

  // « Événements datés » et les trois chips d'activités permanentes demandent
  // des types OPPOSÉS : les activer ensemble ne rendrait rien. Activer l'un
  // relâche donc les autres, plutôt que de laisser l'ordre du code décider en
  // silence lequel gagne.
  const EXCLUSIFS = [['evenements'], ['permanent', 'insolite', 'valeur-sure']];

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const key = chip.dataset.chip;
      if (state.chips.has(key)) state.chips.delete(key);
      else {
        state.chips.add(key);
        const camp = EXCLUSIFS.find((g) => g.includes(key));
        if (camp) {
          for (const autre of EXCLUSIFS.flat()) {
            if (!camp.includes(autre)) state.chips.delete(autre);
          }
        }
      }
      for (const c of chips) {
        c.setAttribute('aria-pressed', String(state.chips.has(c.dataset.chip)));
      }
      apply();
    });
  }

  function resetAll() {
    state.query = '';
    state.chips.clear();
    input.value = '';
    timeLimitEl.value = '';
    sortEl.value = 'pertinence';
    for (const sec of Object.values(SECTIONS)) sec.page = 1;
    if (originEl) originEl.value = '';
    // Le point de départ retombe à « inconnu », pas au centre du secteur : mieux
    // vaut ne pas afficher de temps que d'en afficher un depuis un point que le
    // visiteur n'a pas choisi.
    userPos = null;
    geostate.textContent = '';
    for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
    apply();
  }
  resetBtn.addEventListener('click', resetAll);
  document.getElementById('empty-reset').addEventListener('click', resetAll);

  for (const btn of document.querySelectorAll('[data-example]')) {
    btn.addEventListener('click', () => {
      input.value = btn.textContent;
      form.requestSubmit();
    });
  }

  // Premier calcul au chargement. Sans lui, le compteur gardait la valeur rendue
  // par le serveur — « 36 événements » — alors que la grille affichait déjà les
  // 336 tuiles, événements ET activités permanentes : le chiffre annonçait un
  // dixième de ce qu'on avait sous les yeux jusqu'à la première interaction.
  apply();
</script>
