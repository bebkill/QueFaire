---
import Base from '../layouts/Base.astro';
import citiesData from '../data/cities.json';

const base = import.meta.env.BASE_URL;

// Villes (épicentres) actives, triées par nom. `url` pointe vers un déploiement
// dédié si renseigné, sinon la ville ouvre le site courant (base).
const cities = [...citiesData.cities].sort((a, b) => a.name.localeCompare(b.name, 'fr'));
// c.url est un sous-chemin relatif à la base (« villemoirieu/ ») ou une URL
// absolue (déploiement dédié). Vide = ville « en préparation ».
const cityUrl = (c) => (!c.url ? base : c.url.startsWith('http') ? c.url : base + c.url);
// « Prête » = son agenda est ouvrable : déploiement dédié (url) ou déjà crawlée
// (event_count numérique). Sinon la ville est référencée mais « en préparation ».
const isReady = (c) => Boolean(c.url) || typeof c.event_count === 'number';

const count = cities.length;
const latest = citiesData.generated_at;
const latestLabel = latest
  ? new Date(latest).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<Base title="Où que faire ? — choisir sa ville">
  <main class="wrap prose">
    <h1>Où sortir&nbsp;?</h1>
    <p class="cities-meta">
      <strong>{count}</strong> {count > 1 ? 'villes actives' : 'ville active'}
      {latestLabel && (<> · dernière mise à jour le <strong>{latestLabel}</strong></>)}
    </p>
    <p>
      Choisissez votre secteur&nbsp;: laissez-nous vous <strong>localiser</strong>, tapez le nom d'une
      ville, ou cliquez sur la carte. QueFaire ouvrira l'agenda du bon épicentre.
    </p>

    <div class="cities-controls">
      <button id="locate" type="button" class="btn-locate">📍 Me localiser</button>
      <input id="city-search" type="search" placeholder="Chercher une ville…" aria-label="Chercher une ville" />
    </div>
    <p id="locate-result" class="locate-result" role="status"></p>

    <div id="cities-map" class="cities-map" aria-label="Carte des villes actives"></div>

    <ul id="cities-list" class="cities-list">
      {cities.map((c) => (
        <li class="city-card" data-name={c.name.toLowerCase()} data-id={c.id}>
          <div class="city-card-head">
            <h2>{c.name}</h2>
            {typeof c.event_count === 'number' && (
              <span class="city-count">{c.event_count} événements</span>
            )}
          </div>
          <p class="city-radius">Rayon ~{Math.round(c.radius_minutes)} min de trajet</p>
          {isReady(c)
            ? <a class="btn-open" href={cityUrl(c)}>Ouvrir QueFaire — {c.name}</a>
            : <span class="city-soon">En préparation</span>}
        </li>
      ))}
    </ul>
    <p id="no-city" class="no-city" hidden>Aucune ville ne correspond à cette recherche.</p>
  </main>

  <script id="cities-data" type="application/json" is:inline set:html={JSON.stringify(cities)}></script>
</Base>

<script>
  // Script BUNDLÉ (pas de define:vars, qui forcerait l'inline et empêcherait le
  // bundler de résoudre `import('leaflet')`). Les données passent par un blob
  // JSON dans le DOM ; la base vient de import.meta.env (remplacée au build).
  const cities = JSON.parse(document.getElementById('cities-data').textContent);
  const base = import.meta.env.BASE_URL;

  const cityUrl = (c) => (!c.url ? base : c.url.startsWith('http') ? c.url : base + c.url);
  const isReady = (c) => Boolean(c.url) || typeof c.event_count === 'number';

  // Distance à vol d'oiseau (haversine) + temps de trajet « corrigé » — même
  // formule que le front (nlsearch.js) pour rester cohérent avec le rayon.
  const distanceKm = (la1, lo1, la2, lo2) => {
    const r = Math.PI / 180;
    const a =
      Math.sin(((la2 - la1) * r) / 2) ** 2 +
      Math.cos(la1 * r) * Math.cos(la2 * r) * Math.sin(((lo2 - lo1) * r) / 2) ** 2;
    return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  };
  const travelMinutes = (km) => (km * 1.35) / Math.min(65, 30 + km) * 60;

  const nearest = (lat, lon) =>
    cities
      .map((c) => ({ c, km: distanceKm(lat, lon, c.center.lat, c.center.lon) }))
      .sort((a, b) => a.km - b.km)[0];

  // --- Recherche par nom ---------------------------------------------------
  const search = document.getElementById('city-search');
  const cards = [...document.querySelectorAll('.city-card')];
  const noCity = document.getElementById('no-city');
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const hit = !q || card.dataset.name.includes(q);
      card.hidden = !hit;
      if (hit) visible++;
    }
    noCity.hidden = visible !== 0;
  });

  // --- Localisation --------------------------------------------------------
  const locateBtn = document.getElementById('locate');
  const locateResult = document.getElementById('locate-result');
  locateBtn.addEventListener('click', () => {
    if (!navigator.geolocation) {
      locateResult.textContent = "La géolocalisation n'est pas disponible sur cet appareil.";
      return;
    }
    locateResult.textContent = 'Localisation en cours…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        const hit = nearest(latitude, longitude);
        if (!hit) return;
        const inside = travelMinutes(hit.km) <= hit.c.radius_minutes;
        const km = Math.round(hit.km);
        locateResult.innerHTML = inside
          ? `Vous êtes dans la zone de <strong>${hit.c.name}</strong>. `
          : `Ville la plus proche : <strong>${hit.c.name}</strong> (à ~${km} km). `;
        if (isReady(hit.c)) {
          const a = document.createElement('a');
          a.href = cityUrl(hit.c);
          a.className = 'btn-open';
          a.textContent = `Ouvrir QueFaire — ${hit.c.name}`;
          locateResult.appendChild(a);
        } else {
          locateResult.insertAdjacentText('beforeend', 'Agenda en préparation.');
        }
        highlight(hit.c.id);
      },
      () => { locateResult.textContent = 'Localisation refusée. Utilisez la recherche ou la carte.'; },
    );
  });

  const highlight = (id) => {
    const card = document.querySelector(`.city-card[data-id="${id}"]`);
    if (!card) return;
    cards.forEach((c) => c.classList.remove('is-active'));
    card.classList.add('is-active');
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  // --- Carte Leaflet (chargée à la demande) --------------------------------
  (async () => {
    const L = (await import('leaflet')).default;
    await import('leaflet/dist/leaflet.css');
    const map = L.map('cities-map', { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap',
      maxZoom: 18,
    }).addTo(map);

    const bounds = L.latLngBounds([]);
    for (const c of cities) {
      const ll = [c.center.lat, c.center.lon];
      bounds.extend(ll);
      // Le rayon (~1 h) : conversion approx. temps→distance (1 h ≈ 48 km).
      const km = c.radius_minutes >= 60 ? 48 : (c.radius_minutes / 60) * 48;
      L.circle(ll, { radius: km * 1000, color: '#2563eb', weight: 1, fillOpacity: 0.06 }).addTo(map);
      const count = typeof c.event_count === 'number' ? `<br>${c.event_count} événements` : '';
      const action = isReady(c)
        ? `<br><a href="${cityUrl(c)}">Ouvrir l'agenda</a>`
        : '<br><em>Agenda en préparation</em>';
      L.marker(ll).addTo(map).bindPopup(`<strong>${c.name}</strong>${count}${action}`);
    }
    if (cities.length === 1) map.setView([cities[0].center.lat, cities[0].center.lon], 10);
    else map.fitBounds(bounds.pad(0.3));
  })();
</script>
